{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { BASE_URL } from '@/config.js';\nimport { mapState } from 'vuex';\nexport default {\n  name: 'MerchantShopEdit',\n  computed: {\n    ...mapState('merchantStore', {\n      merchantId: state => state.merchantId\n    })\n  },\n  data() {\n    return {\n      shopName: '',\n      shopAddress: '',\n      shopImage: null,\n      shopImageUrl: '',\n      errorMessage: '',\n      submitStatus: 'normal' // normal | success\n    };\n  },\n  methods: {\n    onImageChange(e) {\n      const file = e.target.files[0];\n      if (file) {\n        this.shopImage = file;\n        this.shopImageUrl = URL.createObjectURL(file);\n      }\n    },\n    async fetchShopInfo() {\n      try {\n        const params = new URLSearchParams({\n          merchantId: this.merchantId\n        }).toString();\n        const response = await fetch(`${BASE_URL}/shop?${params}`);\n        const result = await response.json();\n        if (result.success && result.code === 200 && result.data) {\n          this.shopName = result.data.shopName;\n          this.shopAddress = result.data.shopAddress;\n          // 服务器返回 base64 图片数据\n          this.shopImageUrl = result.data.shopImg ? `data:image/png;base64,${result.data.shopImg}` : '';\n        } else {\n          this.errorMessage = '店铺信息获取失败';\n        }\n      } catch (e) {\n        this.errorMessage = '网络错误，店铺信息获取失败';\n      }\n    },\n    async handleEdit() {\n      if (!this.shopName || !this.shopAddress) {\n        this.errorMessage = '请填写完整信息';\n        return;\n      }\n      this.errorMessage = '';\n      // 构造 FormData\n      const formData = new FormData();\n      formData.append('shopName', this.shopName);\n      formData.append('shopAddress', this.shopAddress);\n      if (this.shopImage) {\n        formData.append('shopImage', this.shopImage);\n      }\n      formData.append('merchantId', this.merchantId); // 发送商家id\n\n      try {\n        const response = await fetch(`${BASE_URL}/merchant/edit`, {\n          method: 'POST',\n          body: formData\n        });\n        const result = await response.json();\n        if (result.status === 'success') {\n          this.submitStatus = 'success';\n        } else {\n          this.errorMessage = '未能成功修改，请重试';\n        }\n      } catch (e) {\n        this.errorMessage = '网络错误，未能成功修改';\n      }\n    },\n    goBack() {\n      this.$router.push('/merchant/shop');\n    }\n  },\n  mounted() {\n    this.fetchShopInfo();\n  }\n};","map":{"version":3,"names":["BASE_URL","mapState","name","computed","merchantId","state","data","shopName","shopAddress","shopImage","shopImageUrl","errorMessage","submitStatus","methods","onImageChange","e","file","target","files","URL","createObjectURL","fetchShopInfo","params","URLSearchParams","toString","response","fetch","result","json","success","code","shopImg","handleEdit","formData","FormData","append","method","body","status","goBack","$router","push","mounted"],"sources":["G:\\2025spring\\SE\\project\\code\\code_vsc\\software-engineering-big-work\\front_end\\src\\views\\MerchantViews\\MerchantShopEdit.vue"],"sourcesContent":["<template>\r\n  <div class=\"register-view\">\r\n    <div class=\"login-header\">\r\n      <img src=\"@/assets/logo.jpg\" alt=\"logo\" class=\"login-logo\" />\r\n      <span class=\"login-title\">编辑店铺信息</span>\r\n    </div>\r\n    <form @submit.prevent=\"handleEdit\">\r\n      <div class=\"form-group\">\r\n        <label>店铺名称：</label>\r\n        <input v-model=\"shopName\" type=\"text\" required placeholder=\"请输入店铺名称\" :disabled=\"submitStatus==='success'\" />\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label>店铺地址：</label>\r\n        <input v-model=\"shopAddress\" type=\"text\" required placeholder=\"请输入店铺地址\" :disabled=\"submitStatus==='success'\" />\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label>店铺图片：</label>\r\n        <input type=\"file\" accept=\"image/*\" @change=\"onImageChange\" :disabled=\"submitStatus==='success'\" />\r\n        <div v-if=\"shopImageUrl\" class=\"preview-img\">\r\n          <img :src=\"shopImageUrl\" alt=\"店铺图片预览\" />\r\n        </div>\r\n      </div>\r\n      <button\r\n        v-if=\"submitStatus==='normal'\"\r\n        type=\"submit\"\r\n        class=\"submit-btn\"\r\n      >修改店铺信息</button>\r\n      <button\r\n        v-else\r\n        type=\"button\"\r\n        class=\"submit-btn\"\r\n        @click=\"goBack\"\r\n      >修改已提交，点击返回主页面</button>\r\n    </form>\r\n    <p v-if=\"errorMessage\" class=\"error-message\">{{ errorMessage }}</p>\r\n    <div class=\"login-support\">\r\n      support by 藤田ことねファングールプ\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { BASE_URL } from '@/config.js'\r\nimport { mapState } from 'vuex'\r\n\r\nexport default {\r\n  name: 'MerchantShopEdit',\r\n  computed: {\r\n    ...mapState('merchantStore', {\r\n      merchantId: state => state.merchantId\r\n    })\r\n  },\r\n  data() {\r\n    return {\r\n      shopName: '',\r\n      shopAddress: '',\r\n      shopImage: null,\r\n      shopImageUrl: '',\r\n      errorMessage: '',\r\n      submitStatus: 'normal' // normal | success\r\n    }\r\n  },\r\n  methods: {\r\n    onImageChange(e) {\r\n      const file = e.target.files[0]\r\n      if (file) {\r\n        this.shopImage = file\r\n        this.shopImageUrl = URL.createObjectURL(file)\r\n      }\r\n    },\r\n    async fetchShopInfo() {\r\n      try {\r\n        const params = new URLSearchParams({ merchantId: this.merchantId }).toString()\r\n        const response = await fetch(`${BASE_URL}/shop?${params}`)\r\n        const result = await response.json()\r\n        if (result.success && result.code === 200 && result.data) {\r\n          this.shopName = result.data.shopName\r\n          this.shopAddress = result.data.shopAddress\r\n          // 服务器返回 base64 图片数据\r\n          this.shopImageUrl = result.data.shopImg\r\n            ? `data:image/png;base64,${result.data.shopImg}`\r\n            : ''\r\n        } else {\r\n          this.errorMessage = '店铺信息获取失败'\r\n        }\r\n      } catch (e) {\r\n        this.errorMessage = '网络错误，店铺信息获取失败'\r\n      }\r\n    },\r\n    async handleEdit() {\r\n      if (!this.shopName || !this.shopAddress) {\r\n        this.errorMessage = '请填写完整信息'\r\n        return\r\n      }\r\n      this.errorMessage = ''\r\n      // 构造 FormData\r\n      const formData = new FormData()\r\n      formData.append('shopName', this.shopName)\r\n      formData.append('shopAddress', this.shopAddress)\r\n      if (this.shopImage) {\r\n        formData.append('shopImage', this.shopImage)\r\n      }\r\n      formData.append('merchantId', this.merchantId) // 发送商家id\r\n\r\n      try {\r\n        const response = await fetch(`${BASE_URL}/merchant/edit`, {\r\n          method: 'POST',\r\n          body: formData\r\n        })\r\n        const result = await response.json()\r\n        if (result.status === 'success') {\r\n          this.submitStatus = 'success'\r\n        } else {\r\n          this.errorMessage = '未能成功修改，请重试'\r\n        }\r\n      } catch (e) {\r\n        this.errorMessage = '网络错误，未能成功修改'\r\n      }\r\n    },\r\n    goBack() {\r\n      this.$router.push('/merchant/shop')\r\n    }\r\n  },\r\n  mounted() {\r\n    this.fetchShopInfo()\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.login-header {\r\n  display: flex;\r\n  align-items: center;\r\n  margin-bottom: 1.5em;\r\n}\r\n.login-logo {\r\n  width: 48px;\r\n  height: 48px;\r\n  object-fit: contain;\r\n  margin-right: 1em;\r\n}\r\n.login-title {\r\n  font-size: 2em;\r\n  font-weight: bold;\r\n  color: #333;\r\n}\r\n.form-group {\r\n  margin-bottom: 1.2em;\r\n}\r\ninput[type=\"text\"], input[type=\"file\"] {\r\n  width: 100%;\r\n  padding: 0.5em;\r\n  border-radius: 4px;\r\n  border: 1px solid #bfbfbf;\r\n  font-size: 1em;\r\n  margin-top: 0.3em;\r\n}\r\n.submit-btn {\r\n  background-color: #4caf50;\r\n  color: #fff;\r\n  border: none;\r\n  padding: 0.75em 2.5em;\r\n  border-radius: 10px;\r\n  font-size: 1.2em;\r\n  cursor: pointer;\r\n  margin-top: 1em;\r\n}\r\n.submit-btn:hover {\r\n  background-color: #43a047;\r\n}\r\n.preview-img {\r\n  margin-top: 0.5em;\r\n}\r\n.preview-img img {\r\n  max-width: 100%;\r\n  max-height: 120px;\r\n  border-radius: 6px;\r\n  border: 1px solid #eee;\r\n}\r\n.login-support {\r\n  margin-top: 2em;\r\n  text-align: center;\r\n  font-size: 0.85em;\r\n  color: #888;\r\n}\r\n.error-message {\r\n  color: red;\r\n  margin: 1em 0;\r\n}\r\n</style>"],"mappings":";AA0CA,SAASA,QAAO,QAAS,aAAY;AACrC,SAASC,QAAO,QAAS,MAAK;AAE9B,eAAe;EACbC,IAAI,EAAE,kBAAkB;EACxBC,QAAQ,EAAE;IACR,GAAGF,QAAQ,CAAC,eAAe,EAAE;MAC3BG,UAAU,EAAEC,KAAI,IAAKA,KAAK,CAACD;IAC7B,CAAC;EACH,CAAC;EACDE,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,WAAW,EAAE,EAAE;MACfC,SAAS,EAAE,IAAI;MACfC,YAAY,EAAE,EAAE;MAChBC,YAAY,EAAE,EAAE;MAChBC,YAAY,EAAE,QAAO,CAAE;IACzB;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,aAAaA,CAACC,CAAC,EAAE;MACf,MAAMC,IAAG,GAAID,CAAC,CAACE,MAAM,CAACC,KAAK,CAAC,CAAC;MAC7B,IAAIF,IAAI,EAAE;QACR,IAAI,CAACP,SAAQ,GAAIO,IAAG;QACpB,IAAI,CAACN,YAAW,GAAIS,GAAG,CAACC,eAAe,CAACJ,IAAI;MAC9C;IACF,CAAC;IACD,MAAMK,aAAaA,CAAA,EAAG;MACpB,IAAI;QACF,MAAMC,MAAK,GAAI,IAAIC,eAAe,CAAC;UAAEnB,UAAU,EAAE,IAAI,CAACA;QAAW,CAAC,CAAC,CAACoB,QAAQ,CAAC;QAC7E,MAAMC,QAAO,GAAI,MAAMC,KAAK,CAAC,GAAG1B,QAAQ,SAASsB,MAAM,EAAE;QACzD,MAAMK,MAAK,GAAI,MAAMF,QAAQ,CAACG,IAAI,CAAC;QACnC,IAAID,MAAM,CAACE,OAAM,IAAKF,MAAM,CAACG,IAAG,KAAM,GAAE,IAAKH,MAAM,CAACrB,IAAI,EAAE;UACxD,IAAI,CAACC,QAAO,GAAIoB,MAAM,CAACrB,IAAI,CAACC,QAAO;UACnC,IAAI,CAACC,WAAU,GAAImB,MAAM,CAACrB,IAAI,CAACE,WAAU;UACzC;UACA,IAAI,CAACE,YAAW,GAAIiB,MAAM,CAACrB,IAAI,CAACyB,OAAM,GAClC,yBAAyBJ,MAAM,CAACrB,IAAI,CAACyB,OAAO,EAAC,GAC7C,EAAC;QACP,OAAO;UACL,IAAI,CAACpB,YAAW,GAAI,UAAS;QAC/B;MACF,EAAE,OAAOI,CAAC,EAAE;QACV,IAAI,CAACJ,YAAW,GAAI,eAAc;MACpC;IACF,CAAC;IACD,MAAMqB,UAAUA,CAAA,EAAG;MACjB,IAAI,CAAC,IAAI,CAACzB,QAAO,IAAK,CAAC,IAAI,CAACC,WAAW,EAAE;QACvC,IAAI,CAACG,YAAW,GAAI,SAAQ;QAC5B;MACF;MACA,IAAI,CAACA,YAAW,GAAI,EAAC;MACrB;MACA,MAA