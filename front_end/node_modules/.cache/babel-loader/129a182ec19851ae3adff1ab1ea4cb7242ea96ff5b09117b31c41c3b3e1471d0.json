{"ast":null,"code":"import { createElementVNode as _createElementVNode, createCommentVNode as _createCommentVNode, toDisplayString as _toDisplayString, openBlock as _openBlock, createElementBlock as _createElementBlock, resolveComponent as _resolveComponent, createVNode as _createVNode, createTextVNode as _createTextVNode, withCtx as _withCtx } from \"vue\";\nimport _imports_0 from '@/assets/logo.jpg';\nconst _hoisted_1 = {\n  class: \"login-view\"\n};\nconst _hoisted_2 = {\n  key: 0,\n  class: \"error-message\"\n};\nexport function render(_ctx, _cache, $props, $setup, $data, $options) {\n  const _component_AuthForm = _resolveComponent(\"AuthForm\");\n  const _component_router_link = _resolveComponent(\"router-link\");\n  return _openBlock(), _createElementBlock(\"div\", _hoisted_1, [_cache[2] || (_cache[2] = _createElementVNode(\"div\", {\n    class: \"login-header\"\n  }, [_createElementVNode(\"img\", {\n    src: _imports_0,\n    alt: \"logo\",\n    class: \"login-logo\"\n  }), _createElementVNode(\"span\", {\n    class: \"login-title\"\n  }, \"饿了吗，那就登录吧\")], -1 /* HOISTED */)), _createCommentVNode(\" 在模板中显示错误信息 \"), _ctx.errorMessage ? (_openBlock(), _createElementBlock(\"p\", _hoisted_2, _toDisplayString(_ctx.errorMessage), 1 /* TEXT */)) : _createCommentVNode(\"v-if\", true), _createVNode(_component_AuthForm, {\n    \"form-type\": \"login\",\n    onSubmit: $options.handleLogin\n  }, null, 8 /* PROPS */, [\"onSubmit\"]), _createElementVNode(\"p\", null, [_cache[1] || (_cache[1] = _createTextVNode(\" Don't have an account? \")), _createVNode(_component_router_link, {\n    to: \"/register\"\n  }, {\n    default: _withCtx(() => _cache[0] || (_cache[0] = [_createTextVNode(\"Register here\")])),\n    _: 1 /* STABLE */,\n    __: [0]\n  })]), _cache[3] || (_cache[3] = _createElementVNode(\"div\", {\n    class: \"login-support\"\n  }, \" support by 藤田ことねファングールプ \", -1 /* HOISTED */))]);\n}","map":{"version":3,"names":["_imports_0","class","key","_createElementBlock","_hoisted_1","_createElementVNode","src","alt","_createCommentVNode","_ctx","errorMessage","_hoisted_2","_toDisplayString","_createVNode","_component_AuthForm","onSubmit","$options","handleLogin","_createTextVNode","_component_router_link","to","default","_withCtx","_cache","_","__"],"sources":["G:\\2025spring\\SE\\project\\code\\code_vsc\\software-engineering-big-work\\front_end\\src\\views\\LoginView.vue"],"sourcesContent":["<!--\r\n  LoginView.vue 组件说明\r\n\r\n  本页面用于展示用户登录界面，包含：\r\n  - 顶部 logo 和标题\r\n  - 登录表单（支持用户类型选择）\r\n  - 错误信息提示\r\n  - 跳转到注册页面的链接\r\n  - 页面底部支持信息\r\n  页面切换时会自动清空错误信息。\r\n-->\r\n\r\n<template>\r\n  <div class=\"login-view\">\r\n    <div class=\"login-header\">\r\n      <img src=\"@/assets/logo.jpg\" alt=\"logo\" class=\"login-logo\" />\r\n      <span class=\"login-title\">饿了吗，那就登录吧</span>\r\n    </div>\r\n    <!-- 在模板中显示错误信息 -->\r\n    <p v-if=\"errorMessage\" class=\"error-message\">{{ errorMessage }}</p>\r\n    <AuthForm form-type=\"login\" @submit=\"handleLogin\"/>\r\n    <p>\r\n      Don't have an account? \r\n      <router-link to=\"/register\">Register here</router-link>\r\n    </p>\r\n    <div class=\"login-support\">\r\n      support by 藤田ことねファングールプ\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { mapState, mapActions, mapMutations } from 'vuex'\r\nimport AuthForm from '@/components/AuthForm.vue'\r\n\r\nexport default {\r\n  name: 'LoginView',\r\n  components: {\r\n    AuthForm\r\n  },\r\n  computed: {\r\n    ...mapState('userStore', ['errorMessage'])\r\n  },\r\n  methods: {\r\n    ...mapActions('userStore', ['loginUser']),\r\n    ...mapMutations('userStore', ['SET_ERROR']),\r\n    /**\r\n     * 处理登录表单提交\r\n     * @param {Object} userData - 登录表单收集到的数据（包含邮箱、密码、用户类型等）\r\n     * 调用 loginUser action 进行登录，成功后跳转页面，失败时自动显示错误信息\r\n     */\r\n    async handleLogin(userData) {\r\n      console.log('LoginView:Login data:', userData)\r\n      \r\n      // 验证数据格式\r\n      if (!userData || typeof userData !== 'object' || userData.isTrusted) {\r\n        console.error('接收到错误的数据格式:', userData)\r\n        return\r\n      }\r\n      \r\n      const success = await this.loginUser(userData)\r\n      \r\n      if (success.success) {\r\n        console.log('LoginView:Login success:', success)\r\n        \r\n        // 修复：使用正确的用户类型判断\r\n        const userKind = success.data?.userKind || userData.role || this.$store.state.userStore.userInfo.userKind\r\n        console.log('LoginView:User kind:', userKind)\r\n        \r\n        switch (userKind) {\r\n          case 'user':\r\n            this.$router.push('/user')\r\n            break\r\n          case 'seller':\r\n            this.$router.push('/seller')\r\n            break\r\n          case 'rider':\r\n            this.$router.push('/rider')\r\n            break\r\n          case 'admin':\r\n            this.$router.push('/admin')\r\n            break\r\n          default:\r\n            console.warn('未知的用户类型:', userKind)\r\n            this.$router.push('/user') // 默认跳转到用户页面\r\n        }\r\n      } else {\r\n        console.log('LoginView:Login failed:', success)\r\n        // 错误信息已经通过 commit('SET_ERROR') 设置到 store 中了\r\n      }\r\n    }\r\n  },\r\n  beforeRouteLeave(to, from, next) {\r\n    this.$store.commit('userStore/SET_ERROR', '')\r\n    next()\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.login-header {\r\n  display: flex;\r\n  align-items: center;\r\n  margin-bottom: 1.5em;\r\n}\r\n.login-logo {\r\n  width: 48px;\r\n  height: 48px;\r\n  object-fit: contain;\r\n  margin-right: 1em;\r\n}\r\n.login-title {\r\n  font-size: 2em;\r\n  font-weight: bold;\r\n  color: #333;\r\n}\r\n.login-support {\r\n  margin-top: 2em;\r\n  text-align: center;\r\n  font-size: 0.85em;\r\n  color: #888;\r\n}\r\n</style>"],"mappings":";OAeWA,UAAuB;;EAF3BC,KAAK,EAAC;AAAY;;EAbzBC,GAAA;EAmB2BD,KAAK,EAAC;;;;;uBAN/BE,mBAAA,CAeM,OAfNC,UAeM,G,0BAdJC,mBAAA,CAGM;IAHDJ,KAAK,EAAC;EAAc,IACvBI,mBAAA,CAA6D;IAAxDC,GAAuB,EAAvBN,UAAuB;IAACO,GAAG,EAAC,MAAM;IAACN,KAAK,EAAC;MAC9CI,mBAAA,CAA0C;IAApCJ,KAAK,EAAC;EAAa,GAAC,WAAS,E,sBAErCO,mBAAA,gBAAmB,EACVC,IAAA,CAAAC,YAAY,I,cAArBP,mBAAA,CAAmE,KAAnEQ,UAAmE,EAAAC,gBAAA,CAAnBH,IAAA,CAAAC,YAAY,oBAnBhEF,mBAAA,gBAoBIK,YAAA,CAAmDC,mBAAA;IAAzC,WAAS,EAAC,OAAO;IAAEC,QAAM,EAAEC,QAAA,CAAAC;yCACrCZ,mBAAA,CAGI,Y,0BAxBRa,gBAAA,CAqBO,0BAED,IAAAL,YAAA,CAAuDM,sBAAA;IAA1CC,EAAE,EAAC;EAAW;IAvBjCC,OAAA,EAAAC,QAAA,CAuBkC,MAAaC,MAAA,QAAAA,MAAA,OAvB/CL,gBAAA,CAuBkC,eAAa,E;IAvB/CM,CAAA;IAAAC,EAAA;kCAyBIpB,mBAAA,CAEM;IAFDJ,KAAK,EAAC;EAAe,GAAC,2BAE3B,qB","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}