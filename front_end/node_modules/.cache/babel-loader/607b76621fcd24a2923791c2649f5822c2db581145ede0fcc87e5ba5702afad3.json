{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport BottomNav from '@/components/bottomNav.vue';\nimport { BASE_URL, fetchWithTimeout } from '@/config.js';\nimport { mapState } from 'vuex';\nexport default {\n  name: 'RiderOrdersView',\n  components: {\n    BottomNav\n  },\n  data() {\n    return {\n      allOrders: [{\n        id: 3001,\n        merchantName: \"麦当劳\",\n        merchantAddress: \"美食街18号\",\n        userAddress: \"学生公寓3号楼201\",\n        createTime: \"2025-05-23 14:00\"\n      }, {\n        id: 3002,\n        merchantName: \"肯德基\",\n        merchantAddress: \"中心广场2楼\",\n        userAddress: \"教学楼A座办公室\",\n        createTime: \"2025-05-23 14:30\"\n      }, {\n        id: 3003,\n        merchantName: \"星巴克\",\n        merchantAddress: \"图书馆一楼\",\n        userAddress: \"行政楼305\",\n        createTime: \"2025-05-23 15:00\"\n      }, {\n        id: 3004,\n        merchantName: \"食堂二楼\",\n        merchantAddress: \"学生食堂二楼8号窗口\",\n        userAddress: \"宿舍楼C区302\",\n        createTime: \"2025-05-23 15:30\"\n      }, {\n        id: 3005,\n        merchantName: \"北门餐厅\",\n        merchantAddress: \"北门商业街5号\",\n        userAddress: \"图书馆二楼\",\n        createTime: \"2025-05-23 16:00\"\n      }, {\n        id: 3006,\n        merchantName: \"西门小吃\",\n        merchantAddress: \"西门小吃街3号摊位\",\n        userAddress: \"宿舍楼B区506\",\n        createTime: \"2025-05-23 16:30\"\n      }, {\n        id: 3007,\n        merchantName: \"麦当劳\",\n        merchantAddress: \"东门分店\",\n        userAddress: \"宿舍楼A区203\",\n        createTime: \"2025-05-23 17:00\"\n      }, {\n        id: 3008,\n        merchantName: \"必胜客\",\n        merchantAddress: \"中心广场3楼\",\n        userAddress: \"教学楼B座201\",\n        createTime: \"2025-05-23 17:30\"\n      }, {\n        id: 3009,\n        merchantName: \"德克士\",\n        merchantAddress: \"南门商业街\",\n        userAddress: \"图书馆三楼\",\n        createTime: \"2025-05-23 18:00\"\n      }, {\n        id: 3010,\n        merchantName: \"华莱士\",\n        merchantAddress: \"学生街12号\",\n        userAddress: \"宿舍楼D区401\",\n        createTime: \"2025-05-23 18:30\"\n      }, {\n        id: 3011,\n        merchantName: \"一点点\",\n        merchantAddress: \"中心广场1楼\",\n        userAddress: \"行政楼208\",\n        createTime: \"2025-05-23 19:00\"\n      }, {\n        id: 3012,\n        merchantName: \"喜茶\",\n        merchantAddress: \"东门商业区\",\n        userAddress: \"教学楼C座105\",\n        createTime: \"2025-05-23 19:30\"\n      }],\n      merchantNameFilter: '',\n      userAddressFilter: '',\n      page: 1,\n      pageSize: 10,\n      jumpPage: 1,\n      navItems: [{\n        label: '回到主页面',\n        action: () => {\n          this.$router.push('/rider');\n        }\n      }]\n    };\n  },\n  computed: {\n    ...mapState('riderStore', ['riderId']),\n    filteredOrders() {\n      return this.allOrders.filter(order => {\n        const matchMerchant = !this.merchantNameFilter || order.merchantName.toLowerCase().includes(this.merchantNameFilter.toLowerCase());\n        const matchAddress = !this.userAddressFilter || order.userAddress.toLowerCase().includes(this.userAddressFilter.toLowerCase());\n        return matchMerchant && matchAddress;\n      });\n    },\n    pagedOrders() {\n      const start = (this.page - 1) * this.pageSize;\n      return this.filteredOrders.slice(start, start + this.pageSize);\n    },\n    totalPages() {\n      return Math.ceil(this.filteredOrders.length / this.pageSize) || 1;\n    }\n  },\n  methods: {\n    goToOrderDetail(orderId) {\n      this.$router.push(`/rider/order/${orderId}`);\n    },\n    applyFilter() {\n      this.page = 1;\n      this.jumpPage = 1;\n      // 在真实环境中，这里可以调用后端接口重新获取数据\n      // this.fetchOrders()\n    },\n    clearFilter() {\n      this.merchantNameFilter = '';\n      this.userAddressFilter = '';\n      this.page = 1;\n      this.jumpPage = 1;\n      // 在真实环境中，这里可以调用后端接口重新获取数据\n      // this.fetchOrders()\n    },\n    changePage(p) {\n      if (p < 1) p = 1;\n      if (p > this.totalPages) p = this.totalPages;\n      this.page = p;\n      this.jumpPage = p;\n    },\n    async grabOrder(orderId) {\n      // 模拟网络请求\n      const success = Math.random() > 0.3; // 70% 成功率\n\n      if (success) {\n        alert('抢单成功！');\n        // 将订单从列表中移除\n        const orderIndex = this.allOrders.findIndex(o => o.id === orderId);\n        if (orderIndex !== -1) {\n          this.allOrders.splice(orderIndex, 1);\n        }\n        // 如果当前页没有订单了，回到上一页\n        if (this.pagedOrders.length === 0 && this.page > 1) {\n          this.changePage(this.page - 1);\n        }\n      } else {\n        alert('抢单失败：该订单可能已被其他骑手接取');\n      }\n\n      // 真实环境下的代码：\n      // try {\n      //   const response = await fetchWithTimeout(`${BASE_URL}/rider/chooseorder`, {\n      //     method: 'POST',\n      //     headers: { 'Content-Type': 'application/json' },\n      //     body: JSON.stringify({ \n      //       riderId: this.riderId,\n      //       orderId \n      //     })\n      //   })\n      //   const result = await response.json()\n      //   if (result.success) {\n      //     alert('抢单成功！')\n      //     this.fetchOrders()\n      //   } else {\n      //     alert('抢单失败：' + (result.message || '该订单可能已被其他骑手接取'))\n      //   }\n      // } catch (e) {\n      //   alert('网络错误，抢单失败')\n      // }\n    },\n    async fetchOrders() {\n      // 真实环境下的代码：\n      // try {\n      //   const params = new URLSearchParams({\n      //     merchantName: this.merchantNameFilter,\n      //     userAddress: this.userAddressFilter,\n      //     page: this.page,\n      //     pageSize: this.pageSize\n      //   }).toString()\n      //   const response = await fetchWithTimeout(`${BASE_URL}/rider/available-orders?${params}`)\n      //   const result = await response.json()\n      //   if (result.success && Array.isArray(result.data)) {\n      //     this.allOrders = result.data\n      //   } else {\n      //     this.allOrders = []\n      //   }\n      // } catch (e) {\n      //   console.error('获取订单失败', e)\n      //   this.allOrders = []\n      // }\n      console.log('获取订单数据 (使用本地数据)');\n    }\n  },\n  mounted() {\n    // this.fetchOrders()\n  }\n};","map":{"version":3,"names":["BottomNav","BASE_URL","fetchWithTimeout","mapState","name","components","data","allOrders","id","merchantName","merchantAddress","userAddress","createTime","merchantNameFilter","userAddressFilter","page","pageSize","jumpPage","navItems","label","action","$router","push","computed","filteredOrders","filter","order","matchMerchant","toLowerCase","includes","matchAddress","pagedOrders","start","slice","totalPages","Math","ceil","length","methods","goToOrderDetail","orderId","applyFilter","clearFilter","changePage","p","grabOrder","success","random","alert","orderIndex","findIndex","o","splice","fetchOrders","console","log","mounted"],"sources":["G:\\2025spring\\SE\\project\\code\\code_vsc\\software-engineering-big-work\\front_end\\src\\views\\RiderViews\\RiderOrdersView.vue"],"sourcesContent":["<template>\r\n  <div class=\"rider-orders-view\">\r\n    <!-- 订单过滤器 -->\r\n    <div class=\"filter-section\">\r\n      <div class=\"filter-row\">\r\n        <label>商家名称：</label>\r\n        <input type=\"text\" v-model=\"merchantNameFilter\" placeholder=\"输入商家名称\" />\r\n      </div>\r\n      <div class=\"filter-row\">\r\n        <label>用户地址：</label>\r\n        <input type=\"text\" v-model=\"userAddressFilter\" placeholder=\"输入用户地址\" />\r\n      </div>\r\n      <div class=\"filter-actions\">\r\n        <button @click=\"applyFilter\" class=\"filter-btn\">搜索</button>\r\n        <button @click=\"clearFilter\" class=\"clear-btn\">清空</button>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 订单列表 -->\r\n    <div class=\"order-list\">\r\n      <div class=\"order-item\" v-for=\"order in pagedOrders\" :key=\"order.id\" @click=\"goToOrderDetail(order.id)\">\r\n        <div class=\"order-info\">\r\n          <div class=\"order-detail\">\r\n            <div class=\"merchant-name\">{{ order.merchantName }}</div>\r\n            <div class=\"merchant-address\">商家地址：{{ order.merchantAddress }}</div>\r\n            <div class=\"user-address\">用户地址：{{ order.userAddress }}</div>\r\n            <div class=\"create-time\">创建时间：{{ order.createTime }}</div>\r\n          </div>\r\n        </div>\r\n        <button class=\"action-btn grab-btn\" @click.stop=\"grabOrder(order.id)\">\r\n          抢单\r\n        </button>\r\n      </div>\r\n      <div v-if=\"pagedOrders.length === 0\" class=\"empty-tip\">暂无可抢订单</div>\r\n    </div>\r\n\r\n    <!-- 分页 -->\r\n    <div class=\"pagination-bar\">\r\n      <button :disabled=\"page === 1\" @click=\"changePage(page - 1)\">上一页</button>\r\n      <span>第 {{ page }} 页 / 共 {{ totalPages }} 页</span>\r\n      <button :disabled=\"page === totalPages\" @click=\"changePage(page + 1)\">下一页</button>\r\n      <span>\r\n        跳转到\r\n        <input type=\"number\" v-model.number=\"jumpPage\" min=\"1\" :max=\"totalPages\" style=\"width: 50px;\" />\r\n        <button @click=\"changePage(jumpPage)\">GO</button>\r\n      </span>\r\n    </div>\r\n\r\n    <!-- 底部导航栏 -->\r\n    <BottomNav :navItems=\"navItems\" />\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport BottomNav from '@/components/bottomNav.vue'\r\nimport { BASE_URL, fetchWithTimeout } from '@/config.js'\r\nimport { mapState } from 'vuex'\r\n\r\nexport default {\r\n  name: 'RiderOrdersView',\r\n  components: { BottomNav },\r\n  data() {\r\n    return {\r\n      allOrders: [\r\n        {\r\n          id: 3001,\r\n          merchantName: \"麦当劳\",\r\n          merchantAddress: \"美食街18号\",\r\n          userAddress: \"学生公寓3号楼201\",\r\n          createTime: \"2025-05-23 14:00\"\r\n        },\r\n        {\r\n          id: 3002,\r\n          merchantName: \"肯德基\",\r\n          merchantAddress: \"中心广场2楼\",\r\n          userAddress: \"教学楼A座办公室\",\r\n          createTime: \"2025-05-23 14:30\"\r\n        },\r\n        {\r\n          id: 3003,\r\n          merchantName: \"星巴克\",\r\n          merchantAddress: \"图书馆一楼\",\r\n          userAddress: \"行政楼305\",\r\n          createTime: \"2025-05-23 15:00\"\r\n        },\r\n        {\r\n          id: 3004,\r\n          merchantName: \"食堂二楼\",\r\n          merchantAddress: \"学生食堂二楼8号窗口\",\r\n          userAddress: \"宿舍楼C区302\",\r\n          createTime: \"2025-05-23 15:30\"\r\n        },\r\n        {\r\n          id: 3005,\r\n          merchantName: \"北门餐厅\",\r\n          merchantAddress: \"北门商业街5号\",\r\n          userAddress: \"图书馆二楼\",\r\n          createTime: \"2025-05-23 16:00\"\r\n        },\r\n        {\r\n          id: 3006,\r\n          merchantName: \"西门小吃\",\r\n          merchantAddress: \"西门小吃街3号摊位\",\r\n          userAddress: \"宿舍楼B区506\",\r\n          createTime: \"2025-05-23 16:30\"\r\n        },\r\n        {\r\n          id: 3007,\r\n          merchantName: \"麦当劳\",\r\n          merchantAddress: \"东门分店\",\r\n          userAddress: \"宿舍楼A区203\",\r\n          createTime: \"2025-05-23 17:00\"\r\n        },\r\n        {\r\n          id: 3008,\r\n          merchantName: \"必胜客\",\r\n          merchantAddress: \"中心广场3楼\",\r\n          userAddress: \"教学楼B座201\",\r\n          createTime: \"2025-05-23 17:30\"\r\n        },\r\n        {\r\n          id: 3009,\r\n          merchantName: \"德克士\",\r\n          merchantAddress: \"南门商业街\",\r\n          userAddress: \"图书馆三楼\",\r\n          createTime: \"2025-05-23 18:00\"\r\n        },\r\n        {\r\n          id: 3010,\r\n          merchantName: \"华莱士\",\r\n          merchantAddress: \"学生街12号\",\r\n          userAddress: \"宿舍楼D区401\",\r\n          createTime: \"2025-05-23 18:30\"\r\n        },\r\n        {\r\n          id: 3011,\r\n          merchantName: \"一点点\",\r\n          merchantAddress: \"中心广场1楼\",\r\n          userAddress: \"行政楼208\",\r\n          createTime: \"2025-05-23 19:00\"\r\n        },\r\n        {\r\n          id: 3012,\r\n          merchantName: \"喜茶\",\r\n          merchantAddress: \"东门商业区\",\r\n          userAddress: \"教学楼C座105\",\r\n          createTime: \"2025-05-23 19:30\"\r\n        }\r\n      ],\r\n      merchantNameFilter: '',\r\n      userAddressFilter: '',\r\n      page: 1,\r\n      pageSize: 10,\r\n      jumpPage: 1,\r\n      navItems: [\r\n        { label: '回到主页面', action: () => { this.$router.push('/rider') } }\r\n      ]\r\n    }\r\n  },\r\n  computed: {\r\n    ...mapState('riderStore', ['riderId']),\r\n    filteredOrders() {\r\n      return this.allOrders.filter(order => {\r\n        const matchMerchant = !this.merchantNameFilter || \r\n          order.merchantName.toLowerCase().includes(this.merchantNameFilter.toLowerCase())\r\n        const matchAddress = !this.userAddressFilter || \r\n          order.userAddress.toLowerCase().includes(this.userAddressFilter.toLowerCase())\r\n        return matchMerchant && matchAddress\r\n      })\r\n    },\r\n    pagedOrders() {\r\n      const start = (this.page - 1) * this.pageSize\r\n      return this.filteredOrders.slice(start, start + this.pageSize)\r\n    },\r\n    totalPages() {\r\n      return Math.ceil(this.filteredOrders.length / this.pageSize) || 1\r\n    }\r\n  },\r\n  methods: {\r\n    goToOrderDetail(orderId) {\r\n      this.$router.push(`/rider/order/${orderId}`)\r\n    },\r\n    \r\n    applyFilter() {\r\n      this.page = 1\r\n      this.jumpPage = 1\r\n      // 在真实环境中，这里可以调用后端接口重新获取数据\r\n      // this.fetchOrders()\r\n    },\r\n    \r\n    clearFilter() {\r\n      this.merchantNameFilter = ''\r\n      this.userAddressFilter = ''\r\n      this.page = 1\r\n      this.jumpPage = 1\r\n      // 在真实环境中，这里可以调用后端接口重新获取数据\r\n      // this.fetchOrders()\r\n    },\r\n    \r\n    changePage(p) {\r\n      if (p < 1) p = 1\r\n      if (p > this.totalPages) p = this.totalPages\r\n      this.page = p\r\n      this.jumpPage = p\r\n    },\r\n    \r\n    async grabOrder(orderId) {\r\n      // 模拟网络请求\r\n      const success = Math.random() > 0.3 // 70% 成功率\r\n      \r\n      if (success) {\r\n        alert('抢单成功！')\r\n        // 将订单从列表中移除\r\n        const orderIndex = this.allOrders.findIndex(o => o.id === orderId)\r\n        if (orderIndex !== -1) {\r\n          this.allOrders.splice(orderIndex, 1)\r\n        }\r\n        // 如果当前页没有订单了，回到上一页\r\n        if (this.pagedOrders.length === 0 && this.page > 1) {\r\n          this.changePage(this.page - 1)\r\n        }\r\n      } else {\r\n        alert('抢单失败：该订单可能已被其他骑手接取')\r\n      }\r\n\r\n      // 真实环境下的代码：\r\n      // try {\r\n      //   const response = await fetchWithTimeout(`${BASE_URL}/rider/chooseorder`, {\r\n      //     method: 'POST',\r\n      //     headers: { 'Content-Type': 'application/json' },\r\n      //     body: JSON.stringify({ \r\n      //       riderId: this.riderId,\r\n      //       orderId \r\n      //     })\r\n      //   })\r\n      //   const result = await response.json()\r\n      //   if (result.success) {\r\n      //     alert('抢单成功！')\r\n      //     this.fetchOrders()\r\n      //   } else {\r\n      //     alert('抢单失败：' + (result.message || '该订单可能已被其他骑手接取'))\r\n      //   }\r\n      // } catch (e) {\r\n      //   alert('网络错误，抢单失败')\r\n      // }\r\n    },\r\n    \r\n    async fetchOrders() {\r\n      // 真实环境下的代码：\r\n      // try {\r\n      //   const params = new URLSearchParams({\r\n      //     merchantName: this.merchantNameFilter,\r\n      //     userAddress: this.userAddressFilter,\r\n      //     page: this.page,\r\n      //     pageSize: this.pageSize\r\n      //   }).toString()\r\n      //   const response = await fetchWithTimeout(`${BASE_URL}/rider/available-orders?${params}`)\r\n      //   const result = await response.json()\r\n      //   if (result.success && Array.isArray(result.data)) {\r\n      //     this.allOrders = result.data\r\n      //   } else {\r\n      //     this.allOrders = []\r\n      //   }\r\n      // } catch (e) {\r\n      //   console.error('获取订单失败', e)\r\n      //   this.allOrders = []\r\n      // }\r\n      co