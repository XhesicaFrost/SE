{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { mapState, mapActions, mapMutations } from 'vuex';\nimport AuthForm from '@/components/AuthForm.vue';\nexport default {\n  name: 'LoginView',\n  components: {\n    AuthForm\n  },\n  computed: {\n    ...mapState('userStore', ['errorMessage'])\n  },\n  methods: {\n    ...mapActions('userStore', ['loginUser']),\n    ...mapMutations('userStore', ['SET_ERROR']),\n    /**\r\n     * 处理登录表单提交\r\n     * @param {Object} userData - 登录表单收集到的数据（包含邮箱、密码、用户类型等）\r\n     * 调用 loginUser action 进行登录，成功后跳转页面，失败时自动显示错误信息\r\n     */\n    async handleLogin(userData) {\n      console.log('LoginView:Login data:', userData);\n      if (!userData || typeof userData !== 'object' || userData.isTrusted !== undefined ||\n      // 事件对象特有属性\n      userData.type !== undefined ||\n      // 事件对象特有属性\n      userData.target !== undefined) {\n        // 事件对象特有属性\n        console.error('LoginView:接收到错误的数据格式:', userData);\n        return;\n      }\n      // 验证数据格式\n      if (!userData || typeof userData !== 'object' || userData.isTrusted) {\n        console.error('LoginView:接收到错误的数据格式:', userData);\n        return;\n      }\n      const success = await this.loginUser(userData);\n      if (success.success) {\n        console.log('LoginView:Login success:', success);\n\n        // 修复：使用正确的用户类型判断\n        const userKind = success.data?.userKind || userData.role || this.$store.state.userStore.userInfo.userKind;\n        console.log('LoginView:User kind:', userKind);\n        switch (userKind) {\n          case 'user':\n            this.$router.push('/user');\n            break;\n          case 'seller':\n            this.$router.push('/seller');\n            break;\n          case 'rider':\n            this.$router.push('/rider');\n            break;\n          case 'admin':\n            this.$router.push('/admin');\n            break;\n          default:\n            console.warn('未知的用户类型:', userKind);\n            this.$router.push('/user');\n          // 默认跳转到用户页面\n        }\n      } else {\n        console.log('LoginView:Login failed:', success);\n        // 错误信息已经通过 commit('SET_ERROR') 设置到 store 中了\n      }\n    }\n  },\n  beforeRouteLeave(to, from, next) {\n    this.$store.commit('userStore/SET_ERROR', '');\n    next();\n  }\n};","map":{"version":3,"names":["mapState","mapActions","mapMutations","AuthForm","name","components","computed","methods","handleLogin","userData","console","log","isTrusted","undefined","type","target","error","success","loginUser","userKind","data","role","$store","state","userStore","userInfo","$router","push","warn","beforeRouteLeave","to","from","next","commit"],"sources":["G:\\2025spring\\SE\\project\\code\\code_vsc\\software-engineering-big-work\\front_end\\src\\views\\LoginView.vue"],"sourcesContent":["<!--\r\n  LoginView.vue 组件说明\r\n\r\n  本页面用于展示用户登录界面，包含：\r\n  - 顶部 logo 和标题\r\n  - 登录表单（支持用户类型选择）\r\n  - 错误信息提示\r\n  - 跳转到注册页面的链接\r\n  - 页面底部支持信息\r\n  页面切换时会自动清空错误信息。\r\n-->\r\n\r\n<template>\r\n  <div class=\"login-view\">\r\n    <div class=\"login-header\">\r\n      <img src=\"@/assets/logo.jpg\" alt=\"logo\" class=\"login-logo\" />\r\n      <span class=\"login-title\">饿了吗，那就登录吧</span>\r\n    </div>\r\n    <!-- 在模板中显示错误信息 -->\r\n    <p v-if=\"errorMessage\" class=\"error-message\">{{ errorMessage }}</p>\r\n    <AuthForm form-type=\"login\" @submit=\"handleLogin\"/>\r\n    <p>\r\n      Don't have an account? \r\n      <router-link to=\"/register\">Register here</router-link>\r\n    </p>\r\n    <div class=\"login-support\">\r\n      support by 藤田ことねファングールプ\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { mapState, mapActions, mapMutations } from 'vuex'\r\nimport AuthForm from '@/components/AuthForm.vue'\r\n\r\nexport default {\r\n  name: 'LoginView',\r\n  components: {\r\n    AuthForm\r\n  },\r\n  computed: {\r\n    ...mapState('userStore', ['errorMessage'])\r\n  },\r\n  methods: {\r\n    ...mapActions('userStore', ['loginUser']),\r\n    ...mapMutations('userStore', ['SET_ERROR']),\r\n    /**\r\n     * 处理登录表单提交\r\n     * @param {Object} userData - 登录表单收集到的数据（包含邮箱、密码、用户类型等）\r\n     * 调用 loginUser action 进行登录，成功后跳转页面，失败时自动显示错误信息\r\n     */\r\n    async handleLogin(userData) {\r\n      console.log('LoginView:Login data:', userData)\r\n      if (!userData || \r\n          typeof userData !== 'object' || \r\n          userData.isTrusted !== undefined ||  // 事件对象特有属性\r\n          userData.type !== undefined ||       // 事件对象特有属性\r\n          userData.target !== undefined) {     // 事件对象特有属性\r\n          console.error('LoginView:接收到错误的数据格式:', userData)\r\n        return\r\n      }\r\n      // 验证数据格式\r\n      if (!userData || typeof userData !== 'object' || userData.isTrusted) {\r\n        console.error('LoginView:接收到错误的数据格式:', userData)\r\n        return\r\n      }\r\n      \r\n      const success = await this.loginUser(userData)\r\n      \r\n      if (success.success) {\r\n        console.log('LoginView:Login success:', success)\r\n        \r\n        // 修复：使用正确的用户类型判断\r\n        const userKind = success.data?.userKind || userData.role || this.$store.state.userStore.userInfo.userKind\r\n        console.log('LoginView:User kind:', userKind)\r\n        \r\n        switch (userKind) {\r\n          case 'user':\r\n            this.$router.push('/user')\r\n            break\r\n          case 'seller':\r\n            this.$router.push('/seller')\r\n            break\r\n          case 'rider':\r\n            this.$router.push('/rider')\r\n            break\r\n          case 'admin':\r\n            this.$router.push('/admin')\r\n            break\r\n          default:\r\n            console.warn('未知的用户类型:', userKind)\r\n            this.$router.push('/user') // 默认跳转到用户页面\r\n        }\r\n      } else {\r\n        console.log('LoginView:Login failed:', success)\r\n        // 错误信息已经通过 commit('SET_ERROR') 设置到 store 中了\r\n      }\r\n    }\r\n  },\r\n  beforeRouteLeave(to, from, next) {\r\n    this.$store.commit('userStore/SET_ERROR', '')\r\n    next()\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.login-header {\r\n  display: flex;\r\n  align-items: center;\r\n  margin-bottom: 1.5em;\r\n}\r\n.login-logo {\r\n  width: 48px;\r\n  height: 48px;\r\n  object-fit: contain;\r\n  margin-right: 1em;\r\n}\r\n.login-title {\r\n  font-size: 2em;\r\n  font-weight: bold;\r\n  color: #333;\r\n}\r\n.login-support {\r\n  margin-top: 2em;\r\n  text-align: center;\r\n  font-size: 0.85em;\r\n  color: #888;\r\n}\r\n</style>"],"mappings":";AAgCA,SAASA,QAAQ,EAAEC,UAAU,EAAEC,YAAW,QAAS,MAAK;AACxD,OAAOC,QAAO,MAAO,2BAA0B;AAE/C,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,QAAQ,EAAE;IACR,GAAGN,QAAQ,CAAC,WAAW,EAAE,CAAC,cAAc,CAAC;EAC3C,CAAC;EACDO,OAAO,EAAE;IACP,GAAGN,UAAU,CAAC,WAAW,EAAE,CAAC,WAAW,CAAC,CAAC;IACzC,GAAGC,YAAY,CAAC,WAAW,EAAE,CAAC,WAAW,CAAC,CAAC;IAC3C;;;;;IAKA,MAAMM,WAAWA,CAACC,QAAQ,EAAE;MAC1BC,OAAO,CAACC,GAAG,CAAC,uBAAuB,EAAEF,QAAQ;MAC7C,IAAI,CAACA,QAAO,IACR,OAAOA,QAAO,KAAM,QAAO,IAC3BA,QAAQ,CAACG,SAAQ,KAAMC,SAAQ;MAAM;MACrCJ,QAAQ,CAACK,IAAG,KAAMD,SAAQ;MAAW;MACrCJ,QAAQ,CAACM,MAAK,KAAMF,SAAS,EAAE;QAAM;QACrCH,OAAO,CAACM,KAAK,CAAC,uBAAuB,EAAEP,QAAQ;QACjD;MACF;MACA;MACA,IAAI,CAACA,QAAO,IAAK,OAAOA,QAAO,KAAM,QAAO,IAAKA,QAAQ,CAACG,SAAS,EAAE;QACnEF,OAAO,CAACM,KAAK,CAAC,uBAAuB,EAAEP,QAAQ;QAC/C;MACF;MAEA,MAAMQ,OAAM,GAAI,MAAM,IAAI,CAACC,SAAS,CAACT,QAAQ;MAE7C,IAAIQ,OAAO,CAACA,OAAO,EAAE;QACnBP,OAAO,CAACC,GAAG,CAAC,0BAA0B,EAAEM,OAAO;;QAE/C;QACA,MAAME,QAAO,GAAIF,OAAO,CAACG,IAAI,EAAED,QAAO,IAAKV,QAAQ,CAACY,IAAG,IAAK,IAAI,CAACC,MAAM,CAACC,KAAK,CAACC,SAAS,CAACC,QAAQ,CAACN,QAAO;QACxGT,OAAO,CAACC,GAAG,CAAC,sBAAsB,EAAEQ,QAAQ;QAE5C,QAAQA,QAAQ;UACd,KAAK,MAAM;YACT,IAAI,CAACO,OAAO,CAACC,IAAI,CAAC,OAAO;YACzB;UACF,KAAK,QAAQ;YACX,IAAI,CAACD,OAAO,CAACC,IAAI,CAAC,SAAS;YAC3B;UACF,KAAK,OAAO;YACV,IAAI,CAACD,OAAO,CAACC,IAAI,CAAC,QAAQ;YAC1B;UACF,KAAK,OAAO;YACV,IAAI,CAACD,OAAO,CAACC,IAAI,CAAC,QAAQ;YAC1B;UACF;YACEjB,OAAO,CAACkB,IAAI,CAAC,UAAU,EAAET,QAAQ;YACjC,IAAI,CAACO,OAAO,CAACC,IAAI,CAAC,OAAO;UAAE;QAC/B;MACF,OAAO;QAC