{"ast":null,"code":"export default {\n  name: 'BottomNav',\n  props: {\n    navItems: {\n      type: Array,\n      required: true\n      // 每项格式: { label: '显示内容', action: Function }\n    }\n  },\n  methods: {\n    handleClick(item) {\n      if (typeof item.action === 'function') {\n        item.action();\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","props","navItems","type","Array","required","methods","handleClick","item","action"],"sources":["G:\\2025spring\\SE\\project\\code\\code_vsc\\software-engineering-big-work\\front_end\\src\\components\\bottomNav.vue"],"sourcesContent":["<!-- filepath: front_end/src/components/bottomNav.vue -->\r\n<template>\r\n  <div class=\"bottom-nav\">\r\n    <div\r\n      v-for=\"(item, idx) in navItems\"\r\n      :key=\"idx\"\r\n      class=\"nav-item\"\r\n      @click=\"handleClick(item)\"\r\n    >\r\n      {{ item.label }}\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'BottomNav',\r\n  props: {\r\n    navItems: {\r\n      type: Array,\r\n      required: true\r\n      // 每项格式: { label: '显示内容', action: Function }\r\n    }\r\n  },\r\n  methods: {\r\n    handleClick(item) {\r\n      if (typeof item.action === 'function') {\r\n        item.action()\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.bottom-nav {\r\n  display: flex;\r\n  justify-content: space-around;\r\n  align-items: center;\r\n  background: #fff;\r\n  border-top: 1px solid #eee;\r\n  height: 56px;\r\n  position: fixed;\r\n  left: 50%;\r\n  bottom: 0;\r\n  transform: translateX(-50%);\r\n  width: 100%;\r\n  max-width: 400px;\r\n  box-sizing: border-box;\r\n}\r\n.nav-item {\r\n  flex: 1;\r\n  text-align: center;\r\n  color: #3498db;\r\n  font-size: 1.1em;\r\n  cursor: pointer;\r\n  padding: 0.7em 0;\r\n  transition: background 0.2s;\r\n}\r\n.nav-item:hover {\r\n  background: #f0f8ff;\r\n}\r\n</style>"],"mappings":"AAeA,eAAe;EACbA,IAAI,EAAE,WAAW;EACjBC,KAAK,EAAE;IACLC,QAAQ,EAAE;MACRC,IAAI,EAAEC,