{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { BASE_URL } from '@/config.js';\nexport default {\n  name: 'sellerItemEdit',\n  data() {\n    return {\n      itemId: '',\n      // 商品ID\n      itemName: '',\n      itemImage: null,\n      itemImageUrl: '',\n      itemPrice: '',\n      itemDescription: '',\n      errorMessage: '',\n      submitStatus: 'normal' // normal | success\n    };\n  },\n  methods: {\n    onImageChange(e) {\n      const file = e.target.files[0];\n      if (file) {\n        this.itemImage = file;\n        this.itemImageUrl = URL.createObjectURL(file);\n      }\n    },\n    async fetchItemInfo() {\n      // 获取商品信息用于预填充\n      try {\n        const params = new URLSearchParams({\n          id: this.itemId\n        }).toString();\n        const response = await fetch(`${BASE_URL}/seller/item?${params}`);\n        const result = await response.json();\n        if (result.success && result.code === 200 && result.data) {\n          this.itemName = result.data.itemName;\n          this.itemPrice = result.data.itemPrice;\n          // 服务器返回 base64 图片数据\n          this.itemImageUrl = result.data.itemImage ? `data:image/png;base64,${result.data.itemImage}` : '';\n          this.itemDescription = result.data.itemDescription || '';\n        } else {\n          this.errorMessage = '商品信息获取失败';\n        }\n      } catch (e) {\n        this.errorMessage = '网络错误，商品信息获取失败';\n      }\n    },\n    async handleEdit() {\n      if (!this.itemName || this.itemPrice === '' || this.itemPrice === null) {\n        this.errorMessage = '请填写完整信息';\n        return;\n      }\n      this.errorMessage = '';\n      // 构造 FormData\n      const formData = new FormData();\n      formData.append('itemId', this.itemId);\n      formData.append('itemName', this.itemName);\n      formData.append('itemPrice', this.itemPrice);\n      formData.append('itemDescription', this.itemDescription);\n      if (this.itemImage) {\n        formData.append('itemImage', this.itemImage);\n      }\n      try {\n        const response = await fetch(`${BASE_URL}/seller/item/register`, {\n          method: 'POST',\n          body: formData\n        });\n        const result = await response.json();\n        if (result.status === 'success') {\n          this.submitStatus = 'success';\n        } else {\n          this.errorMessage = '未能成功修改，请重试';\n        }\n      } catch (e) {\n        this.errorMessage = '网络错误，未能成功修改';\n      }\n    },\n    goBack() {\n      this.$router.push('/seller/shop');\n    }\n  },\n  mounted() {\n    // 从路由获取商品ID\n    console.log(\"sellerItemEdit mounted\");\n    this.itemId = this.$route.params.id;\n    this.fetchItemInfo();\n  }\n};","map":{"version":3,"names":["BASE_URL","name","data","itemId","itemName","itemImage","itemImageUrl","itemPrice","itemDescription","errorMessage","submitStatus","methods","onImageChange","e","file","target","files","URL","createObjectURL","fetchItemInfo","params","URLSearchParams","id","toString","response","fetch","result","json","success","code","handleEdit","formData","FormData","append","method","body","status","goBack","$router","push","mounted","console","log","$route"],"sources":["G:\\2025spring\\SE\\project\\code\\code_vsc\\software-engineering-big-work\\front_end\\src\\views\\SellerViews\\SellerItemEdit.vue"],"sourcesContent":["<template>\r\n  <div class=\"register-view\">\r\n    <div class=\"login-header\">\r\n      <img src=\"@/assets/logo.jpg\" alt=\"logo\" class=\"login-logo\" />\r\n      <span class=\"login-title\">编辑商品信息</span>\r\n    </div>\r\n    <form @submit.prevent=\"handleEdit\">\r\n      <div class=\"form-group\">\r\n        <label>商品名称：</label>\r\n        <input v-model=\"itemName\" type=\"text\" required placeholder=\"请输入商品名称\" :disabled=\"submitStatus==='success'\" />\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label>商品图片：</label>\r\n        <input type=\"file\" accept=\"image/*\" @change=\"onImageChange\" :disabled=\"submitStatus==='success'\" />\r\n        <div v-if=\"itemImageUrl\" class=\"preview-img\">\r\n          <img :src=\"itemImageUrl\" alt=\"商品图片预览\" />\r\n        </div>\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label>商品描述：</label>\r\n        <input v-model=\"itemDescription\" type=\"text\" required placeholder=\"请输入商品描述\" :disabled=\"submitStatus==='success'\" />\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label>单价：</label>\r\n        <input v-model.number=\"itemPrice\" type=\"number\" min=\"0\" step=\"0.01\" required placeholder=\"请输入单价\" :disabled=\"submitStatus==='success'\" />\r\n      </div>\r\n      <button\r\n        v-if=\"submitStatus==='normal'\"\r\n        type=\"submit\"\r\n        class=\"submit-btn\"\r\n      >保存修改</button>\r\n      <button\r\n        v-else\r\n        type=\"button\"\r\n        class=\"submit-btn\"\r\n        @click=\"goBack\"\r\n      >修改已提交，点击返回商品管理</button>\r\n    </form>\r\n    <p v-if=\"errorMessage\" class=\"error-message\">{{ errorMessage }}</p>\r\n    <div class=\"login-support\">\r\n      support by 藤田ことねファングールプ\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { BASE_URL } from '@/config.js'\r\n\r\nexport default {\r\n  name: 'sellerItemEdit',\r\n  data() {\r\n    return {\r\n      itemId: '', // 商品ID\r\n      itemName: '',\r\n      itemImage: null,\r\n      itemImageUrl: '',\r\n      itemPrice: '',\r\n      itemDescription: '',\r\n      errorMessage: '',\r\n      submitStatus: 'normal' // normal | success\r\n    }\r\n  },\r\n  methods: {\r\n    onImageChange(e) {\r\n      const file = e.target.files[0]\r\n      if (file) {\r\n        this.itemImage = file\r\n        this.itemImageUrl = URL.createObjectURL(file)\r\n      }\r\n    },\r\n    async fetchItemInfo() {\r\n      // 获取商品信息用于预填充\r\n      try {\r\n        const params = new URLSearchParams({ id: this.itemId }).toString()\r\n        const response = await fetch(`${BASE_URL}/seller/item?${params}`)\r\n        const result = await response.json()\r\n        if (result.success && result.code === 200 && result.data) {\r\n          this.itemName = result.data.itemName\r\n          this.itemPrice = result.data.itemPrice\r\n          // 服务器返回 base64 图片数据\r\n          this.itemImageUrl = result.data.itemImage\r\n            ? `data:image/png;base64,${result.data.itemImage}`\r\n            : ''\r\n          this.itemDescription = result.data.itemDescription || ''\r\n        } else {\r\n          this.errorMessage = '商品信息获取失败'\r\n        }\r\n      } catch (e) {\r\n        this.errorMessage = '网络错误，商品信息获取失败'\r\n      }\r\n    },\r\n    async handleEdit() {\r\n      if (!this.itemName || this.itemPrice === '' || this.itemPrice === null) {\r\n        this.errorMessage = '请填写完整信息'\r\n        return\r\n      }\r\n      this.errorMessage = ''\r\n      // 构造 FormData\r\n      const formData = new FormData()\r\n      formData.append('itemId', this.itemId)\r\n      formData.append('itemName', this.itemName)\r\n      formData.append('itemPrice', this.itemPrice)\r\n      formData.append('itemDescription', this.itemDescription)\r\n      if (this.itemImage) {\r\n        formData.append('itemImage', this.itemImage)\r\n      }\r\n      try {\r\n        const response = await fetch(`${BASE_URL}/seller/item/register`, {\r\n          method: 'POST',\r\n          body: formData\r\n        })\r\n        const result = await response.json()\r\n        if (result.status === 'success') {\r\n          this.submitStatus = 'success'\r\n        } else {\r\n          this.errorMessage = '未能成功修改，请重试'\r\n        }\r\n      } catch (e) {\r\n        this.errorMessage = '网络错误，未能成功修改'\r\n      }\r\n    },\r\n    goBack() {\r\n      this.$router.push('/seller/shop')\r\n    }\r\n  },\r\n  mounted() {\r\n    // 从路由获取商品ID\r\n    console.log(\"sellerItemEdit mounted\")\r\n    this.itemId = this.$route.params.id\r\n    this.fetchItemInfo()\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.login-header {\r\n  display: flex;\r\n  align-items: center;\r\n  margin-bottom: 1.5em;\r\n}\r\n.login-logo {\r\n  width: 48px;\r\n  height: 48px;\r\n  object-fit: contain;\r\n  margin-right: 1em;\r\n}\r\n.login-title {\r\n  font-size: 2em;\r\n  font-weight: bold;\r\n  color: #333;\r\n}\r\n.form-group {\r\n  margin-bottom: 1.2em;\r\n}\r\ninput[type=\"text\"], input[type=\"file\"], input[type=\"number\"] {\r\n  width: 100%;\r\n  padding: 0.5em;\r\n  border-radius: 4px;\r\n  border: 1px solid #bfbfbf;\r\n  font-size: 1em;\r\n  margin-top: 0.3em;\r\n}\r\n.submit-btn {\r\n  background-color: #4caf50;\r\n  color: #fff;\r\n  border: none;\r\n  padding: 0.75em 2.5em;\r\n  border-radius: 10px;\r\n  font-size: 1.2em;\r\n  cursor: pointer;\r\n  margin-top: 1em;\r\n}\r\n.submit-btn:hover {\r\n  background-color: #43a047;\r\n}\r\n.preview-img {\r\n  margin-top: 0.5em;\r\n}\r\n.preview-img img {\r\n  max-width: 100%;\r\n  max-height: 120px;\r\n  border-radius: 6px;\r\n  border: 1px solid #eee;\r\n}\r\n.login-support {\r\n  margin-top: 2em;\r\n  text-align: center;\r\n  font-size: 0.85em;\r\n  color: #888;\r\n}\r\n.error-message {\r\n  color: red;\r\n  margin: 1em 0;\r\n}\r\n</style>"],"mappings":";AA8CA,SAASA,QAAO,QAAS,aAAY;AAErC,eAAe;EACbC,IAAI,EAAE,gBAAgB;EACtBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,MAAM,EAAE,EAAE;MAAE;MACZC,QAAQ,EAAE,EAAE;MACZC,SAAS,EAAE,IAAI;MACfC,YAAY,EAAE,EAAE;MAChBC,SAAS,EAAE,EAAE;MACbC,eAAe,EAAE,EAAE;MACnBC,YAAY,EAAE,EAAE;MAChBC,YAAY,EAAE,QAAO,CAAE;IACzB;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,aAAaA,CAACC,CAAC,EAAE;MACf,MAAMC,IAAG,GAAID,CAAC,CAACE,MAAM,CAACC,KAAK,CAAC,CAAC;MAC7B,IAAIF,IAAI,EAAE;QACR,IAAI,CAACT,SAAQ,GAAIS,IAAG;QACpB,IAAI,CAACR,YAAW,GAAIW,GAAG,CAACC,eAAe,CAACJ,IAAI;MAC9C;IACF,CAAC;IACD,MAAMK,aAAaA,CAAA,EAAG;MACpB;MACA,IAAI;QACF,MAAMC,MAAK,GAAI,IAAIC,eAAe,CAAC;UAAEC,EAAE,EAAE,IAAI,CAACnB;QAAO,CAAC,CAAC,CAACoB,QAAQ,CAAC;QACjE,MAAMC,QAAO,GAAI,MAAMC,KAAK,CAAC,GAAGzB,QAAQ,gBAAgBoB,MAAM,EAAE;QAChE,MAAMM,MAAK,GAAI,MAAMF,QAAQ,CAACG,IAAI,CAAC;QACnC,IAAID,MAAM,CAACE,OAAM,IAAKF,MAAM,CAACG,IAAG,KAAM,GAAE,IAAKH,MAAM,CAACxB,IA