{"ast":null,"code":"import { createElementVNode as _createElementVNode, createCommentVNode as _createCommentVNode, resolveComponent as _resolveComponent, createVNode as _createVNode, toDisplayString as _toDisplayString, openBlock as _openBlock, createElementBlock as _createElementBlock, createTextVNode as _createTextVNode, withCtx as _withCtx } from \"vue\";\nconst _hoisted_1 = {\n  class: \"login-view\"\n};\nconst _hoisted_2 = {\n  key: 0,\n  class: \"error-message\"\n};\nexport function render(_ctx, _cache, $props, $setup, $data, $options) {\n  const _component_AuthForm = _resolveComponent(\"AuthForm\");\n  const _component_router_link = _resolveComponent(\"router-link\");\n  return _openBlock(), _createElementBlock(\"div\", _hoisted_1, [_cache[2] || (_cache[2] = _createElementVNode(\"h2\", null, \"用户登录\", -1 /* HOISTED */)), _createCommentVNode(\" 确保只有一个事件监听器 \"), _createVNode(_component_AuthForm, {\n    \"form-type\": \"login\",\n    onSubmit: $options.handleLogin\n  }, null, 8 /* PROPS */, [\"onSubmit\"]), _createCommentVNode(\" 显示错误信息 \"), _ctx.errorMessage ? (_openBlock(), _createElementBlock(\"div\", _hoisted_2, _toDisplayString(_ctx.errorMessage), 1 /* TEXT */)) : _createCommentVNode(\"v-if\", true), _createElementVNode(\"p\", null, [_cache[1] || (_cache[1] = _createTextVNode(\" 还没有账户？ \")), _createVNode(_component_router_link, {\n    to: \"/register\"\n  }, {\n    default: _withCtx(() => _cache[0] || (_cache[0] = [_createTextVNode(\"立即注册\")])),\n    _: 1 /* STABLE */,\n    __: [0]\n  })])]);\n}","map":{"version":3,"names":["class","key","_createElementBlock","_hoisted_1","_createElementVNode","_createCommentVNode","_createVNode","_component_AuthForm","onSubmit","$options","handleLogin","_ctx","errorMessage","_hoisted_2","_toDisplayString","_createTextVNode","_component_router_link","to","default","_withCtx","_cache","_","__"],"sources":["G:\\2025spring\\SE\\project\\code\\code_vsc\\software-engineering-big-work\\front_end\\src\\views\\LoginView.vue"],"sourcesContent":["<!--\r\n  LoginView.vue 组件说明\r\n\r\n  本页面用于展示用户登录界面，包含：\r\n  - 顶部 logo 和标题\r\n  - 登录表单（支持用户类型选择）\r\n  - 错误信息提示\r\n  - 跳转到注册页面的链接\r\n  - 页面底部支持信息\r\n  页面切换时会自动清空错误信息。\r\n-->\r\n\r\n<template>\r\n  <div class=\"login-view\">\r\n    <h2>用户登录</h2>\r\n    \r\n    <!-- 确保只有一个事件监听器 -->\r\n    <AuthForm \r\n      form-type=\"login\" \r\n      @submit=\"handleLogin\"\r\n    />\r\n    \r\n    <!-- 显示错误信息 -->\r\n    <div v-if=\"errorMessage\" class=\"error-message\">\r\n      {{ errorMessage }}\r\n    </div>\r\n    \r\n    <p>\r\n      还没有账户？ \r\n      <router-link to=\"/register\">立即注册</router-link>\r\n    </p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport AuthForm from '@/components/AuthForm.vue'\r\nimport { mapState, mapActions, mapMutations } from 'vuex'\r\n\r\nexport default {\r\n  name: 'LoginView',\r\n  components: {\r\n    AuthForm\r\n  },\r\n  computed: {\r\n    ...mapState('userStore', ['errorMessage'])\r\n  },\r\n  methods: {\r\n    ...mapActions('userStore', ['loginUser']),\r\n    ...mapMutations('userStore', ['SET_ERROR']),\r\n    \r\n    /**\r\n     * 处理登录表单提交\r\n     * @param {Object} userData - 登录表单收集到的数据\r\n     */\r\n    async handleLogin(userData) {\r\n      console.log('LoginView:Login data:', userData)\r\n      \r\n      // 严格验证数据格式 - 防止事件对象被传递\r\n      if (!userData || \r\n          typeof userData !== 'object' || \r\n          userData.isTrusted !== undefined ||  // 事件对象特有属性\r\n          userData.type !== undefined ||       // 事件对象特有属性\r\n          userData.target !== undefined) {     // 事件对象特有属性\r\n        console.error('接收到错误的数据格式:', userData)\r\n        return\r\n      }\r\n      \r\n      // 验证必要字段\r\n      if (!userData.phonenumber || !userData.password || !userData.role) {\r\n        console.error('表单数据不完整:', userData)\r\n        this.SET_ERROR('请填写完整的登录信息')\r\n        return\r\n      }\r\n      \r\n      try {\r\n        const success = await this.loginUser(userData)\r\n        \r\n        if (success.success) {\r\n          console.log('LoginView:Login success:', success)\r\n          \r\n          // 获取用户类型并跳转\r\n          const userKind = success.data?.userKind || userData.role\r\n          console.log('LoginView:User kind:', userKind)\r\n          \r\n          switch (userKind) {\r\n            case 'user':\r\n              this.$router.push('/user')\r\n              break\r\n            case 'seller':\r\n              this.$router.push('/seller')\r\n              break\r\n            case 'rider':\r\n              this.$router.push('/rider')\r\n              break\r\n            case 'admin':\r\n              this.$router.push('/admin')\r\n              break\r\n            default:\r\n              console.warn('未知的用户类型:', userKind)\r\n              this.$router.push('/user')\r\n          }\r\n        } else {\r\n          console.log('LoginView:Login failed:', success)\r\n        }\r\n      } catch (error) {\r\n        console.error('Login error:', error)\r\n        this.SET_ERROR('登录过程中发生错误')\r\n      }\r\n    }\r\n  },\r\n  \r\n  // 清理错误信息\r\n  mounted() {\r\n    this.SET_ERROR('')\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.login-view {\r\n  max-width: 400px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n}\r\n\r\n.error-message {\r\n  color: #d32f2f;\r\n  background-color: #ffebee;\r\n  padding: 12px;\r\n  border-radius: 4px;\r\n  margin: 16px 0;\r\n  border: 1px solid #ffcdd2;\r\n}\r\n\r\nh2 {\r\n  text-align: center;\r\n  margin-bottom: 20px;\r\n  color: #333;\r\n}\r\n\r\np {\r\n  text-align: center;\r\n  margin-top: 20px;\r\n}\r\n\r\na {\r\n  color: #1976d2;\r\n  text-decoration: none;\r\n}\r\n\r\na:hover {\r\n  text-decoration: underline;\r\n}\r\n</style>"],"mappings":";;EAaOA,KAAK,EAAC;AAAY;;EAbzBC,GAAA;EAuB6BD,KAAK,EAAC;;;;;uBAVjCE,mBAAA,CAkBM,OAlBNC,UAkBM,G,0BAjBJC,mBAAA,CAAa,YAAT,MAAI,sBAERC,mBAAA,iBAAoB,EACpBC,YAAA,CAGEC,mBAAA;IAFA,WAAS,EAAC,OAAO;IAChBC,QAAM,EAAEC,QAAA,CAAAC;yCAGXL,mBAAA,YAAe,EACJM,IAAA,CAAAC,YAAY,I,cAAvBV,mBAAA,CAEM,OAFNW,UAEM,EAAAC,gBAAA,CADDH,IAAA,CAAAC,YAAY,oBAxBrBP,mBAAA,gBA2BID,mBAAA,CAGI,Y,0BA9BRW,gBAAA,CA2BO,UAED,IAAAT,YAAA,CAA8CU,sBAAA;IAAjCC,EAAE,EAAC;EAAW;IA7BjCC,OAAA,EAAAC,QAAA,CA6BkC,MAAIC,MAAA,QAAAA,MAAA,OA7BtCL,gBAAA,CA6BkC,MAAI,E;IA7BtCM,CAAA;IAAAC,EAAA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}