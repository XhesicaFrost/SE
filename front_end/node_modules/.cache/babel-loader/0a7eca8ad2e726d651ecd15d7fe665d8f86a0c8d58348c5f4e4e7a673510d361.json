{"ast":null,"code":"export default {\n  name: 'MerchantRegister',\n  data() {\n    return {\n      shopName: '',\n      shopAddress: '',\n      shopImage: null,\n      shopImageUrl: '',\n      errorMessage: ''\n    };\n  },\n  methods: {\n    onImageChange(e) {\n      const file = e.target.files[0];\n      if (file) {\n        this.shopImage = file;\n        this.shopImageUrl = URL.createObjectURL(file);\n      }\n    },\n    async handleRegister() {\n      if (!this.shopName || !this.shopAddress || !this.shopImage) {\n        this.errorMessage = '请填写完整信息并上传图片';\n        return;\n      }\n      // 这里应提交表单数据到后端，示例仅做提示\n      // 实际开发请用 FormData 方式上传图片\n      alert('注册成功！（请在此处实现实际注册逻辑）');\n      // 注册成功后可跳转页面\n      // this.$router.push('/merchant')\n    }\n  }\n};","map":{"version":3,"names":["name","data","shopName","shopAddress","shopImage","shopImageUrl","errorMessage","methods","onImageChange","e","file","target","files","URL","createObjectURL","handleRegister","alert"],"sources":["G:\\2025spring\\SE\\project\\code\\code_vsc\\software-engineering-big-work\\front_end\\src\\views\\MerchantRegister.vue"],"sourcesContent":["<!--\r\n  MerchantRegister.vue 组件说明\r\n\r\n  本页面用于商家注册店铺，包含：\r\n  - 顶部 logo 和标题\r\n  - 店铺名称输入框\r\n  - 店铺地址输入框\r\n  - 店铺图片上传\r\n  - 注册按钮（绿色，样式参考RegisterView.vue）\r\n  - 错误信息提示\r\n  - 页面底部支持信息\r\n-->\r\n\r\n<template>\r\n  <div class=\"register-view\">\r\n    <div class=\"login-header\">\r\n      <img src=\"@/assets/logo.jpg\" alt=\"logo\" class=\"login-logo\" />\r\n      <span class=\"login-title\">注册您的店铺</span>\r\n    </div>\r\n    <form @submit.prevent=\"handleRegister\">\r\n      <div class=\"form-group\">\r\n        <label>店铺名称：</label>\r\n        <input v-model=\"shopName\" type=\"text\" required placeholder=\"请输入店铺名称\" />\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label>店铺地址：</label>\r\n        <input v-model=\"shopAddress\" type=\"text\" required placeholder=\"请输入店铺地址\" />\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label>店铺图片：</label>\r\n        <input type=\"file\" accept=\"image/*\" @change=\"onImageChange\" />\r\n        <div v-if=\"shopImageUrl\" class=\"preview-img\">\r\n          <img :src=\"shopImageUrl\" alt=\"店铺图片预览\" />\r\n        </div>\r\n      </div>\r\n      <button type=\"submit\" class=\"submit-btn\">注册店铺</button>\r\n    </form>\r\n    <p v-if=\"errorMessage\" class=\"error-message\">{{ errorMessage }}</p>\r\n    <div class=\"login-support\">\r\n      support by 藤田ことねファングールプ\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'MerchantRegister',\r\n  data() {\r\n    return {\r\n      shopName: '',\r\n      shopAddress: '',\r\n      shopImage: null,\r\n      shopImageUrl: '',\r\n      errorMessage: ''\r\n    }\r\n  },\r\n  methods: {\r\n    onImageChange(e) {\r\n      const file = e.target.files[0]\r\n      if (file) {\r\n        this.shopImage = file\r\n        this.shopImageUrl = URL.createObjectURL(file)\r\n      }\r\n    },\r\n    async handleRegister() {\r\n      if (!this.shopName || !this.shopAddress || !this.shopImage) {\r\n        this.errorMessage = '请填写完整信息并上传图片'\r\n        return\r\n      }\r\n      // 这里应提交表单数据到后端，示例仅做提示\r\n      // 实际开发请用 FormData 方式上传图片\r\n      alert('注册成功！（请在此处实现实际注册逻辑）')\r\n      // 注册成功后可跳转页面\r\n      // this.$router.push('/merchant')\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.login-header {\r\n  display: flex;\r\n  align-items: center;\r\n  margin-bottom: 1.5em;\r\n}\r\n.login-logo {\r\n  width: 48px;\r\n  height: 48px;\r\n  object-fit: contain;\r\n  margin-right: 1em;\r\n}\r\n.login-title {\r\n  font-size: 2em;\r\n  font-weight: bold;\r\n  color: #333;\r\n}\r\n.form-group {\r\n  margin-bottom: 1.2em;\r\n}\r\ninput[type=\"text\"], input[type=\"file\"] {\r\n  width: 100%;\r\n  padding: 0.5em;\r\n  border-radius: 4px;\r\n  border: 1px solid #bfbfbf;\r\n  font-size: 1em;\r\n  margin-top: 0.3em;\r\n}\r\n.submit-btn {\r\n  background-color: #4caf50;\r\n  color: #fff;\r\n  border: none;\r\n  padding: 0.75em 2.5em;\r\n  border-radius: 10px;\r\n  font-size: 1.2em;\r\n  cursor: pointer;\r\n  margin-top: 1em;\r\n}\r\n.submit-btn:hover {\r\n  background-color: #43a047;\r\n}\r\n.preview-img {\r\n  margin-top: 0.5em;\r\n}\r\n.preview-img img {\r\n  max-width: 100%;\r\n  max-height: 120px;\r\n  border-radius: 6px;\r\n  border: 1px solid #eee;\r\n}\r\n.login-support {\r\n  margin-top: 2em;\r\n  text-align: center;\r\n  font-size: 0.85em;\r\n  color: #888;\r\n}\r\n.error-message {\r\n  color: red;\r\n  margin: 1em 0;\r\n}\r\n</style>"],"mappings":"AA6CA,eAAe;EACbA,IAAI,EAAE,kBAAkB;EACxBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,WAAW,EAAE,EAAE;MACfC,SAAS,EAAE,IAAI;MACfC,YAAY,EAAE,EAAE;MAChBC,YAAY,EAAE;IAChB;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,aAAaA,CAACC,CAAC,EAAE;MACf,MAAMC,IAAG,GAAID,CAAC,CAACE,MAAM,CAACC,KAAK,CAAC,CAAC;MAC7B,IAAIF,IAAI,EAAE;QACR,IAAI,CAACN,SAAQ,GAAIM,IAAG;QACpB,IAAI,CAACL,YAAW,GAAIQ,GAAG,CAACC,eAAe,CAACJ,IAAI;MAC9C;IACF,CAAC;IACD,MAAMK,cAAcA,CAAA,EAAG;MACrB,IAAI,CAAC,IAAI,CAACb,QAAO,IAAK,CAAC,IAAI,CAACC,WAAU,IAAK,CAAC,IAAI,CAACC,SAAS,EAAE;QAC1D,IAAI,CAACE,YAAW,GAAI,cAAa;QACjC;MACF;MACA;MACA;MACAU,KAAK,CAAC,qBAAqB;MAC3B;MACA;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}