{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport AuthForm from '@/components/AuthForm.vue';\nimport { mapState, mapActions, mapMutations } from 'vuex';\nexport default {\n  name: 'LoginView',\n  components: {\n    AuthForm\n  },\n  computed: {\n    ...mapState('userStore', ['errorMessage'])\n  },\n  methods: {\n    ...mapActions('userStore', ['loginUser']),\n    ...mapMutations('userStore', ['SET_ERROR']),\n    /**\r\n     * 处理登录表单提交\r\n     * @param {Object} userData - 登录表单收集到的数据\r\n     */\n    async handleLogin(userData) {\n      console.log('LoginView:Login data:', userData);\n\n      // 严格验证数据格式 - 防止事件对象被传递\n      if (!userData || typeof userData !== 'object' || userData.isTrusted !== undefined ||\n      // 事件对象特有属性\n      userData.type !== undefined ||\n      // 事件对象特有属性\n      userData.target !== undefined) {\n        // 事件对象特有属性\n        console.error('接收到错误的数据格式:', userData);\n        return;\n      }\n\n      // 验证必要字段\n      if (!userData.phonenumber || !userData.password || !userData.role) {\n        console.error('表单数据不完整:', userData);\n        this.SET_ERROR('请填写完整的登录信息');\n        return;\n      }\n      try {\n        const success = await this.loginUser(userData);\n        if (success.success) {\n          console.log('LoginView:Login success:', success);\n\n          // 获取用户类型并跳转\n          const userKind = success.data?.userKind || userData.role;\n          console.log('LoginView:User kind:', userKind);\n          switch (userKind) {\n            case 'user':\n              this.$router.push('/user');\n              break;\n            case 'seller':\n              this.$router.push('/seller');\n              break;\n            case 'rider':\n              this.$router.push('/rider');\n              break;\n            case 'admin':\n              this.$router.push('/admin');\n              break;\n            default:\n              console.warn('未知的用户类型:', userKind);\n              this.$router.push('/user');\n          }\n        } else {\n          console.log('LoginView:Login failed:', success);\n        }\n      } catch (error) {\n        console.error('Login error:', error);\n        this.SET_ERROR('登录过程中发生错误');\n      }\n    }\n  },\n  // 清理错误信息\n  mounted() {\n    this.SET_ERROR('');\n  }\n};","map":{"version":3,"names":["AuthForm","mapState","mapActions","mapMutations","name","components","computed","methods","handleLogin","userData","console","log","isTrusted","undefined","type","target","error","phonenumber","password","role","SET_ERROR","success","loginUser","userKind","data","$router","push","warn","mounted"],"sources":["G:\\2025spring\\SE\\project\\code\\code_vsc\\software-engineering-big-work\\front_end\\src\\views\\LoginView.vue"],"sourcesContent":["<!--\r\n  LoginView.vue 组件说明\r\n\r\n  本页面用于展示用户登录界面，包含：\r\n  - 顶部 logo 和标题\r\n  - 登录表单（支持用户类型选择）\r\n  - 错误信息提示\r\n  - 跳转到注册页面的链接\r\n  - 页面底部支持信息\r\n  页面切换时会自动清空错误信息。\r\n-->\r\n\r\n<template>\r\n  <div class=\"login-view\">\r\n    <h2>用户登录</h2>\r\n    \r\n    <!-- 确保只有一个事件监听器 -->\r\n    <AuthForm \r\n      form-type=\"login\" \r\n      @submit=\"handleLogin\"\r\n    />\r\n    \r\n    <!-- 显示错误信息 -->\r\n    <div v-if=\"errorMessage\" class=\"error-message\">\r\n      {{ errorMessage }}\r\n    </div>\r\n    \r\n    <p>\r\n      还没有账户？ \r\n      <router-link to=\"/register\">立即注册</router-link>\r\n    </p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport AuthForm from '@/components/AuthForm.vue'\r\nimport { mapState, mapActions, mapMutations } from 'vuex'\r\n\r\nexport default {\r\n  name: 'LoginView',\r\n  components: {\r\n    AuthForm\r\n  },\r\n  computed: {\r\n    ...mapState('userStore', ['errorMessage'])\r\n  },\r\n  methods: {\r\n    ...mapActions('userStore', ['loginUser']),\r\n    ...mapMutations('userStore', ['SET_ERROR']),\r\n    \r\n    /**\r\n     * 处理登录表单提交\r\n     * @param {Object} userData - 登录表单收集到的数据\r\n     */\r\n    async handleLogin(userData) {\r\n      console.log('LoginView:Login data:', userData)\r\n      \r\n      // 严格验证数据格式 - 防止事件对象被传递\r\n      if (!userData || \r\n          typeof userData !== 'object' || \r\n          userData.isTrusted !== undefined ||  // 事件对象特有属性\r\n          userData.type !== undefined ||       // 事件对象特有属性\r\n          userData.target !== undefined) {     // 事件对象特有属性\r\n        console.error('接收到错误的数据格式:', userData)\r\n        return\r\n      }\r\n      \r\n      // 验证必要字段\r\n      if (!userData.phonenumber || !userData.password || !userData.role) {\r\n        console.error('表单数据不完整:', userData)\r\n        this.SET_ERROR('请填写完整的登录信息')\r\n        return\r\n      }\r\n      \r\n      try {\r\n        const success = await this.loginUser(userData)\r\n        \r\n        if (success.success) {\r\n          console.log('LoginView:Login success:', success)\r\n          \r\n          // 获取用户类型并跳转\r\n          const userKind = success.data?.userKind || userData.role\r\n          console.log('LoginView:User kind:', userKind)\r\n          \r\n          switch (userKind) {\r\n            case 'user':\r\n              this.$router.push('/user')\r\n              break\r\n            case 'seller':\r\n              this.$router.push('/seller')\r\n              break\r\n            case 'rider':\r\n              this.$router.push('/rider')\r\n              break\r\n            case 'admin':\r\n              this.$router.push('/admin')\r\n              break\r\n            default:\r\n              console.warn('未知的用户类型:', userKind)\r\n              this.$router.push('/user')\r\n          }\r\n        } else {\r\n          console.log('LoginView:Login failed:', success)\r\n        }\r\n      } catch (error) {\r\n        console.error('Login error:', error)\r\n        this.SET_ERROR('登录过程中发生错误')\r\n      }\r\n    }\r\n  },\r\n  \r\n  // 清理错误信息\r\n  mounted() {\r\n    this.SET_ERROR('')\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.login-view {\r\n  max-width: 400px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n}\r\n\r\n.error-message {\r\n  color: #d32f2f;\r\n  background-color: #ffebee;\r\n  padding: 12px;\r\n  border-radius: 4px;\r\n  margin: 16px 0;\r\n  border: 1px solid #ffcdd2;\r\n}\r\n\r\nh2 {\r\n  text-align: center;\r\n  margin-bottom: 20px;\r\n  color: #333;\r\n}\r\n\r\np {\r\n  text-align: center;\r\n  margin-top: 20px;\r\n}\r\n\r\na {\r\n  color: #1976d2;\r\n  text-decoration: none;\r\n}\r\n\r\na:hover {\r\n  text-decoration: underline;\r\n}\r\n</style>"],"mappings":";AAmCA,OAAOA,QAAO,MAAO,2BAA0B;AAC/C,SAASC,QAAQ,EAAEC,UAAU,EAAEC,YAAW,QAAS,MAAK;AAExD,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,UAAU,EAAE;IACVL;EACF,CAAC;EACDM,QAAQ,EAAE;IACR,GAAGL,QAAQ,CAAC,WAAW,EAAE,CAAC,cAAc,CAAC;EAC3C,CAAC;EACDM,OAAO,EAAE;IACP,GAAGL,UAAU,CAAC,WAAW,EAAE,CAAC,WAAW,CAAC,CAAC;IACzC,GAAGC,YAAY,CAAC,WAAW,EAAE,CAAC,WAAW,CAAC,CAAC;IAE3C;;;;IAIA,MAAMK,WAAWA,CAACC,QAAQ,EAAE;MAC1BC,OAAO,CAACC,GAAG,CAAC,uBAAuB,EAAEF,QAAQ;;MAE7C;MACA,IAAI,CAACA,QAAO,IACR,OAAOA,QAAO,KAAM,QAAO,IAC3BA,QAAQ,CAACG,SAAQ,KAAMC,SAAQ;MAAM;MACrCJ,QAAQ,CAACK,IAAG,KAAMD,SAAQ;MAAW;MACrCJ,QAAQ,CAACM,MAAK,KAAMF,SAAS,EAAE;QAAM;QACvCH,OAAO,CAACM,KAAK,CAAC,aAAa,EAAEP,QAAQ;QACrC;MACF;;MAEA;MACA,IAAI,CAACA,QAAQ,CAACQ,WAAU,IAAK,CAACR,QAAQ,CAACS,QAAO,IAAK,CAACT,QAAQ,CAACU,IAAI,EAAE;QACjET,OAAO,CAACM,KAAK,CAAC,UAAU,EAAEP,QAAQ;QAClC,IAAI,CAACW,SAAS,CAAC,YAAY;QAC3B;MACF;MAEA,IAAI;QACF,MAAMC,OAAM,GAAI,MAAM,IAAI,CAACC,SAAS,CAACb,QAAQ;QAE7C,IAAIY,OAAO,CAACA,OAAO,EAAE;UACnBX,OAAO,CAACC,GAAG,CAAC,0BAA0B,EAAEU,OAAO;;UAE/C;UACA,MAAME,QAAO,GAAIF,OAAO,CAACG,IAAI,EAAED,QAAO,IAAKd,QAAQ,CAACU,IAAG;UACvDT,OAAO,CAACC,GAAG,CAAC,sBAAsB,EAAEY,QAAQ;UAE5C,QAAQA,QAAQ;YACd,KAAK,MAAM;cACT,IAAI,CAACE,OAAO,CAACC,IAAI,CAAC,OAAO;cACzB;YACF,KAAK,QAAQ;cACX,IAAI,CAACD,OAAO,CAACC,IAAI,CAAC,SAAS;cAC3B;YACF,KAAK,OAAO;cACV,IAAI,CAACD,OAAO,CAACC,IAAI,CAAC,QAAQ;cAC1B;YACF,KAAK,OAAO;cACV,IAAI,CAACD,OAAO,CAACC,IAAI,CAAC,QAAQ;cAC1B;YACF;cACEhB,OAAO,CAACiB,IAAI,CAAC,UAAU,EAAEJ,QAAQ;cACjC,IAAI,CAACE,OAAO,CAACC,IAAI,CAAC,OAAO;UAC7B;QACF,OAAO;UACLhB,OAAO,CAACC,GAAG,CAAC,yBAAyB,EAAEU,OAAO;QAChD;MACF,EAAE,OAAOL,KAAK,EAAE;QACdN,OAAO,CAACM,KAAK,CAAC,cAAc,EAAEA,KAAK;QACnC,IAAI,CAACI,SAAS,CAAC,WAAW;MAC5B;IACF;EACF,CAAC;EAED;EACAQ,OAAOA,CAAA,EAAG;IACR,IAAI,CAACR,SAAS,CAAC,EAAE;EACnB;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}