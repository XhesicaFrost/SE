{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { mapState, mapActions, mapMutations } from 'vuex';\nimport AuthForm from '@/components/AuthForm.vue';\nexport default {\n  name: 'LoginView',\n  components: {\n    AuthForm\n  },\n  computed: {\n    ...mapState('userStore', ['errorMessage'])\n  },\n  methods: {\n    ...mapActions('userStore', ['loginUser']),\n    ...mapMutations('userStore', ['SET_ERROR']),\n    /**\r\n     * 处理登录表单提交\r\n     * @param {Object} userData - 登录表单收集到的数据（包含邮箱、密码、用户类型等）\r\n     * 调用 loginUser action 进行登录，成功后跳转页面，失败时自动显示错误信息\r\n     */\n    async handleLogin(userData) {\n      console.log('LoginView:Login data:', userData);\n      const success = await this.loginUser(userData);\n      if (success.success) {\n        console.log('LoginView:Login success:', success);\n        this.$router.push('/login');\n      } else {\n        console.log('LoginView:Login failed:', success);\n      }\n    }\n  },\n  beforeRouteLeave(to, from, next) {\n    this.$store.commit('userStore/SET_ERROR', '');\n    next();\n  }\n};","map":{"version":3,"names":["mapState","mapActions","mapMutations","AuthForm","name","components","computed","methods","handleLogin","userData","console","log","success","loginUser","$router","push","beforeRouteLeave","to","from","next","$store","commit"],"sources":["G:\\2025spring\\SE\\project\\code\\code_vsc\\software-engineering-big-work\\front_end\\src\\views\\LoginView.vue"],"sourcesContent":["<!--\r\n  LoginView.vue 组件说明\r\n\r\n  本页面用于展示用户登录界面，包含：\r\n  - 顶部 logo 和标题\r\n  - 登录表单（支持用户类型选择）\r\n  - 错误信息提示\r\n  - 跳转到注册页面的链接\r\n  - 页面底部支持信息\r\n  页面切换时会自动清空错误信息。\r\n-->\r\n\r\n<template>\r\n  <div class=\"login-view\">\r\n    <div class=\"login-header\">\r\n      <img src=\"@/assets/logo.jpg\" alt=\"logo\" class=\"login-logo\" />\r\n      <span class=\"login-title\">饿了吗，那就登录吧</span>\r\n    </div>\r\n    <!-- 在模板中显示错误信息 -->\r\n    <p v-if=\"errorMessage\" class=\"error-message\">{{ errorMessage }}</p>\r\n    <AuthForm form-type=\"login\" @submit=\"handleLogin\"/>\r\n    <p>\r\n      Don't have an account? \r\n      <router-link to=\"/register\">Register here</router-link>\r\n    </p>\r\n    <div class=\"login-support\">\r\n      support by 藤田ことねファングールプ\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { mapState, mapActions, mapMutations } from 'vuex'\r\nimport AuthForm from '@/components/AuthForm.vue'\r\n\r\nexport default {\r\n  name: 'LoginView',\r\n  components: {\r\n    AuthForm\r\n  },\r\n  computed: {\r\n    ...mapState('userStore', ['errorMessage'])\r\n  },\r\n  methods: {\r\n    ...mapActions('userStore', ['loginUser']),\r\n    ...mapMutations('userStore', ['SET_ERROR']),\r\n    /**\r\n     * 处理登录表单提交\r\n     * @param {Object} userData - 登录表单收集到的数据（包含邮箱、密码、用户类型等）\r\n     * 调用 loginUser action 进行登录，成功后跳转页面，失败时自动显示错误信息\r\n     */\r\n    async handleLogin(userData) {\r\n      console.log('LoginView:Login data:', userData)\r\n      const success = await this.loginUser(userData)\r\n      if (success.success) {\r\n        console.log('LoginView:Login success:', success)\r\n        this.$router.push('/login')\r\n      } else {\r\n        console.log('LoginView:Login failed:', success)\r\n      }\r\n    }\r\n  },\r\n  beforeRouteLeave(to, from, next) {\r\n    this.$store.commit('userStore/SET_ERROR', '')\r\n    next()\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.login-header {\r\n  display: flex;\r\n  align-items: center;\r\n  margin-bottom: 1.5em;\r\n}\r\n.login-logo {\r\n  width: 48px;\r\n  height: 48px;\r\n  object-fit: contain;\r\n  margin-right: 1em;\r\n}\r\n.login-title {\r\n  font-size: 2em;\r\n  font-weight: bold;\r\n  color: #333;\r\n}\r\n.login-support {\r\n  margin-top: 2em;\r\n  text-align: center;\r\n  font-size: 0.85em;\r\n  color: #888;\r\n}\r\n</style>"],"mappings":";AAgCA,SAASA,QAAQ,EAAEC,UAAU,EAAEC,YAAW,QAAS,MAAK;AACxD,OAAOC,QAAO,MAAO,2BAA0B;AAE/C,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,QAAQ,EAAE;IACR,GAAGN,QAAQ,CAAC,WAAW,EAAE,CAAC,cAAc,CAAC;EAC3C,CAAC;EACDO,OAAO,EAAE;IACP,GAAGN,UAAU,CAAC,WAAW,EAAE,CAAC,WAAW,CAAC,CAAC;IACzC,GAAGC,YAAY,CAAC,WAAW,EAAE,CAAC,WAAW,CAAC,CAAC;IAC3C;;;;;IAKA,MAAMM,WAAWA,CAACC,QAAQ,EAAE;MAC1BC,OAAO,CAACC,GAAG,CAAC,uBAAuB,EAAEF,QAAQ;MAC7C,MAAMG,OAAM,GAAI,MAAM,IAAI,CAACC,SAAS,CAACJ,QAAQ;MAC7C,IAAIG,OAAO,CAACA,OAAO,EAAE;QACnBF,OAAO,CAACC,GAAG,CAAC,0BAA0B,EAAEC,OAAO;QAC/C,IAAI,CAACE,OAAO,CAACC,IAAI,CAAC,QAAQ;MAC5B,OAAO;QACLL,OAAO,CAACC,GAAG,CAAC,yBAAyB,EAAEC,OAAO;MAChD;IACF;EACF,CAAC;EACDI,gBAAgBA,CAACC,EAAE,EAAEC,IAAI,EAAEC,IAAI,EAAE;IAC/B,IAAI,CAACC,MAAM,CAACC,MAAM,CAAC,qBAAqB,EAAE,EAAE;IAC5CF,IAAI,CAAC;EACP;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}