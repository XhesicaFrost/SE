{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { BASE_URL, fetchWithTimeout } from '@/config.js';\nimport { mapState } from 'vuex';\nexport default {\n  name: 'MerchantPromotionRegister',\n  computed: {\n    ...mapState('merchantStore', {\n      merchantId: state => state.merchantId\n    })\n  },\n  data() {\n    return {\n      promotionName: '',\n      full: '',\n      minus: '',\n      startTime: '',\n      endTime: '',\n      errorMessage: '',\n      submitStatus: 'normal' // normal | success\n    };\n  },\n  methods: {\n    async handleRegister() {\n      if (!this.promotionName || this.full === '' || this.minus === '' || !this.startTime || !this.endTime) {\n        this.errorMessage = '请填写完整信息';\n        return;\n      }\n      this.errorMessage = '';\n      const formData = new FormData();\n      formData.append('promotionName', this.promotionName);\n      formData.append('full', this.full);\n      formData.append('minus', this.minus);\n      formData.append('startTime', this.startTime);\n      formData.append('endTime', this.endTime);\n      formData.append('merchantId', this.merchantId);\n      try {\n        const response = await fetchWithTimeout(`${BASE_URL}/merchant/promotion/register`, {\n          method: 'POST',\n          body: formData\n        });\n        const result = await response.json();\n        if (result.status === 'success') {\n          this.submitStatus = 'success';\n        } else {\n          this.errorMessage = '未能成功发送，请重试';\n          this.promotionName = '';\n          this.full = '';\n          this.minus = '';\n          this.startTime = '';\n          this.endTime = '';\n        }\n      } catch (e) {\n        this.errorMessage = '网络错误或超时，未能成功发送';\n        this.promotionName = '';\n        this.full = '';\n        this.minus = '';\n        this.startTime = '';\n        this.endTime = '';\n      }\n    },\n    goBack() {\n      this.$router.push('/merchant/promotion');\n    }\n  }\n};","map":{"version":3,"names":["BASE_URL","fetchWithTimeout","mapState","name","computed","merchantId","state","data","promotionName","full","minus","startTime","endTime","errorMessage","submitStatus","methods","handleRegister","formData","FormData","append","response","method","body","result","json","status","e","goBack","$router","push"],"sources":["G:\\2025spring\\SE\\project\\code\\code_vsc\\software-engineering-big-work\\front_end\\src\\views\\MerchantViews\\MerchantPromotionRegister.vue"],"sourcesContent":["<template>\r\n  <div class=\"register-view\">\r\n    <div class=\"login-header\">\r\n      <img src=\"@/assets/logo.jpg\" alt=\"logo\" class=\"login-logo\" />\r\n      <span class=\"login-title\">新建促销活动</span>\r\n    </div>\r\n    <form @submit.prevent=\"handleRegister\">\r\n      <div class=\"form-group\">\r\n        <label>活动名称：</label>\r\n        <input v-model=\"promotionName\" type=\"text\" required placeholder=\"请输入活动名称\" :disabled=\"submitStatus==='success'\" />\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label>满多少元：</label>\r\n        <input v-model.number=\"full\" type=\"number\" min=\"0\" step=\"0.01\" required placeholder=\"请输入满减门槛\" :disabled=\"submitStatus==='success'\" />\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label>减多少元：</label>\r\n        <input v-model.number=\"minus\" type=\"number\" min=\"0\" step=\"0.01\" required placeholder=\"请输入减免金额\" :disabled=\"submitStatus==='success'\" />\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label>开始时间：</label>\r\n        <input v-model=\"startTime\" type=\"datetime-local\" required :disabled=\"submitStatus==='success'\" />\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label>结束时间：</label>\r\n        <input v-model=\"endTime\" type=\"datetime-local\" required :disabled=\"submitStatus==='success'\" />\r\n      </div>\r\n      <button\r\n        v-if=\"submitStatus==='normal'\"\r\n        type=\"submit\"\r\n        class=\"submit-btn\"\r\n      >新建活动</button>\r\n      <button\r\n        v-else\r\n        type=\"button\"\r\n        class=\"submit-btn\"\r\n        @click=\"goBack\"\r\n      >已提交，点击返回促销管理</button>\r\n    </form>\r\n    <p v-if=\"errorMessage\" class=\"error-message\">{{ errorMessage }}</p>\r\n    <div class=\"login-support\">\r\n      support by 藤田ことねファングールプ\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { BASE_URL, fetchWithTimeout } from '@/config.js'\r\nimport { mapState } from 'vuex'\r\n\r\nexport default {\r\n  name: 'MerchantPromotionRegister',\r\n  computed: {\r\n    ...mapState('merchantStore', {\r\n      merchantId: state => state.merchantId\r\n    })\r\n  },\r\n  data() {\r\n    return {\r\n      promotionName: '',\r\n      full: '',\r\n      minus: '',\r\n      startTime: '',\r\n      endTime: '',\r\n      errorMessage: '',\r\n      submitStatus: 'normal' // normal | success\r\n    }\r\n  },\r\n  methods: {\r\n    async handleRegister() {\r\n      if (!this.promotionName || this.full === '' || this.minus === '' || !this.startTime || !this.endTime) {\r\n        this.errorMessage = '请填写完整信息'\r\n        return\r\n      }\r\n      this.errorMessage = ''\r\n      const formData = new FormData()\r\n      formData.append('promotionName', this.promotionName)\r\n      formData.append('full', this.full)\r\n      formData.append('minus', this.minus)\r\n      formData.append('startTime', this.startTime)\r\n      formData.append('endTime', this.endTime)\r\n      formData.append('merchantId', this.merchantId)\r\n\r\n      try {\r\n        const response = await fetchWithTimeout(`${BASE_URL}/merchant/promotion/register`, {\r\n          method: 'POST',\r\n          body: formData\r\n        })\r\n        const result = await response.json()\r\n        if (result.status === 'success') {\r\n          this.submitStatus = 'success'\r\n        } else {\r\n          this.errorMessage = '未能成功发送，请重试'\r\n          this.promotionName = ''\r\n          this.full = ''\r\n          this.minus = ''\r\n          this.startTime = ''\r\n          this.endTime = ''\r\n        }\r\n      } catch (e) {\r\n        this.errorMessage = '网络错误或超时，未能成功发送'\r\n        this.promotionName = ''\r\n        this.full = ''\r\n        this.minus = ''\r\n        this.startTime = ''\r\n        this.endTime = ''\r\n      }\r\n    },\r\n    goBack() {\r\n      this.$router.push('/merchant/promotion')\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.login-header {\r\n  display: flex;\r\n  align-items: center;\r\n  margin-bottom: 1.5em;\r\n}\r\n.login-logo {\r\n  width: 48px;\r\n  height: 48px;\r\n  object-fit: contain;\r\n  margin-right: 1em;\r\n}\r\n.login-title {\r\n  font-size: 2em;\r\n  font-weight: bold;\r\n  color: #333;\r\n}\r\n.form-group {\r\n  margin-bottom: 1.2em;\r\n}\r\ninput[type=\"text\"], input[type=\"number\"], input[type=\"datetime-local\"] {\r\n  width: 100%;\r\n  padding: 0.5em;\r\n  border-radius: 4px;\r\n  border: 1px solid #bfbfbf;\r\n  font-size: 1em;\r\n  margin-top: 0.3em;\r\n}\r\n.submit-btn {\r\n  background-color: #4caf50;\r\n  color: #fff;\r\n  border: none;\r\n  padding: 0.75em 2.5em;\r\n  border-radius: 10px;\r\n  font-size: 1.2em;\r\n  cursor: pointer;\r\n  margin-top: 1em;\r\n}\r\n.submit-btn:hover {\r\n  background-color: #43a047;\r\n}\r\n.login-support {\r\n  margin-top: 2em;\r\n  text-align: center;\r\n  font-size: 0.85em;\r\n  color: #888;\r\n}\r\n.error-message {\r\n  color: red;\r\n  margin: 1em 0;\r\n}\r\n</style>"],"mappings":";AA+CA,SAASA,QAAQ,EAAEC,gBAAe,QAAS,aAAY;AACvD,SAASC,QAAO,QAAS,MAAK;AAE9B,eAAe;EACbC,IAAI,EAAE,2BAA2B;EACjCC,QAAQ,EAAE;IACR,GAAGF,QAAQ,CAAC,eAAe,EAAE;MAC3BG,UAAU,EAAEC,KAAI,IAAKA,KAAK,CAACD;IAC7B,CAAC;EACH,CAAC;EACDE,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,aAAa,EAAE,EAAE;MACjBC,IAAI,EAAE,EAAE;MACRC,KAAK,EAAE,EAAE;MACTC,SAAS,EAAE,EAAE;MACbC,OAAO,EAAE,EAAE;MACXC,YAAY,EAAE,EAAE;MAChBC,YAAY,EAAE,QAAO,CAAE;IACzB;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,cAAcA,CAAA,EAAG;MACrB,IAAI,CAAC,IAAI,CAACR,aAAY,IAAK,IAAI,CAACC,IAAG,KAA